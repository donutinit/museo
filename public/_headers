# equivalente a los `add_header` del nginx.conf anterior

# `Link`: con Early Hints activo en la zona, Cloudflare lo repite en un 103
# antes del HTML, así que la conexión a la media se abre mientras el HTML
# todavía viene en camino.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  Content-Security-Policy: default-src 'self'; img-src 'self' https://media.vondiego.com data:; media-src 'self' https://media.vondiego.com; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'
  Link: <https://media.vondiego.com>; rel=preconnect

# assets con hash en el nombre: cache eterna
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# sitemap, robots y favicon: cache corta
/robots.txt
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
/sitemap-index.xml
  Cache-Control: public, max-age=86400
/sitemap-*.xml
  Cache-Control: public, max-age=86400

# subtítulos: se corrigen sin cambiar de nombre, así que una hora y luego
# revalida en segundo plano
/captions/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
