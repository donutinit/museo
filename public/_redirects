# rutas viejas — equivalente a los `return 301` del nginx.conf anterior
# sintaxis: <origen> <destino> <codigo>

# /work/* -> /obra/*, ya con la diagonal canónica.
/work/poasadas  /obra/posadas/      301
/work/poasadas/ /obra/posadas/      301
/work/*         /obra/:splat/       301

# Se corrigió el slug; los enlaces viejos siguen llegando en un salto.
/obra/poasadas  /obra/posadas/      301
/obra/poasadas/ /obra/posadas/      301

# El rollo se renombro a sofia-maximalista; la ruta vieja ya se publico.
/obra/sofia-max  /obra/sofia-maximalista/   301
/obra/sofia-max/ /obra/sofia-maximalista/   301

# /video (indice viejo) -> ancla de cintas en el indice nuevo.
# OJO: solo las rutas exactas. /video/<slug> son paginas reales.
/video          /obra/#cintas       301
/video/         /obra/#cintas       301
