---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Cuadro from '../../components/Cuadro.astro';
import { archivo } from '../../lib/archivo';

const { foto, cinta, piezas } = await archivo();
---

<BaseLayout
  title="archivo"
  description="El archivo completo de Von Diego: rollos de foto y cintas de video."
>
  <section class="contenedor cabecera">
    <h1 class="display cabecera-marca">archivo</h1>
    <p class="voz cabecera-voz">Cada rollo entero, del más nuevo al más viejo.</p>

    <dl class="cabecera-linea edge">
      <div><dt>foto</dt> <dd>{foto.length} rollos</dd></div>
      <div><dt>piezas</dt> <dd>{piezas}</dd></div>
      <div><dt>cinta</dt> <dd>{cinta.length} rollos</dd></div>
    </dl>
  </section>

  <main class="contenedor" id="hoja">
    <div class="banda">
      <h2 class="banda-nombre">foto</h2>
      <p class="edge">{foto.length} rollos, {piezas} piezas</p>
    </div>

    <div class="hoja">
      {foto.map((cuadro, i) => (
        <Cuadro cuadro={cuadro} posicion={i + 1} eager={i < 6} />
      ))}
    </div>

    <div class="banda" id="cintas">
      <h2 class="banda-nombre">cinta</h2>
      <p class="edge">{cinta.length} rollos</p>
    </div>

    <div class="hoja">
      {cinta.map((cuadro, i) => (
        <Cuadro cuadro={cuadro} posicion={i + 1} />
      ))}
    </div>
  </main>
</BaseLayout>
