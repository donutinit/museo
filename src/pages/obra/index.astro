---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Cuadro from '../../components/Cuadro.astro';
import { archivo } from '../../lib/archivo';
import { srcset } from '../../lib/media';
import { grafo, persona, migas, SITIO, ID_PERSONA } from '../../lib/seo';

const { foto, cinta, piezas } = await archivo();
const SIZES = '(max-width: 40rem) 45vw, 350px';
const descripcion = `Portafolio de Von Diego: ${foto.length} series fotográficas y ${cinta.length} videos de retrato, eventos, obra personal y trabajo comercial en Monterrey.`;

const esquema = grafo(
  persona(),
  {
    '@type': 'CollectionPage',
    '@id': `${SITIO}/obra/#archivo`,
    name: 'Portafolio de fotografía y video de Von Diego',
    description: descripcion,
    inLanguage: 'es-MX',
    about: { '@id': ID_PERSONA },
  },
  migas([
    { nombre: 'inicio', ruta: '/' },
    { nombre: 'archivo', ruta: '/obra/' },
  ])
);
---

<BaseLayout
  title="Portafolio de fotografía y video en Monterrey"
  description={descripcion}
  precargar={foto[0]?.src}
  precargarSrcset={foto[0] ? srcset(foto[0].src) : undefined}
  precargarSizes={SIZES}
  esquema={esquema}
>
  <section class="contenedor cabecera">
    <h1 class="display cabecera-marca">archivo</h1>
    <p class="voz cabecera-voz">Cada rollo entero, del más nuevo al más viejo.</p>

    <dl class="cabecera-linea edge">
      <div data-nosnippet><dt>foto</dt> <dd>{foto.length} rollos</dd></div>
      <div data-nosnippet><dt>piezas</dt> <dd>{piezas}</dd></div>
      <div data-nosnippet><dt>cinta</dt> <dd>{cinta.length} rollos</dd></div>
    </dl>
  </section>

  <main class="contenedor" id="hoja">
    <div class="banda" data-nosnippet>
      <h2 class="banda-nombre">foto</h2>
      <p class="edge">{foto.length} rollos, {piezas} piezas</p>
    </div>

    <div class="hoja">
      {foto.map((cuadro, i) => (
        <Cuadro cuadro={cuadro} posicion={i + 1} eager={i === 0} />
      ))}
    </div>

    <div class="banda" id="cintas" data-nosnippet>
      <h2 class="banda-nombre">cinta</h2>
      <p class="edge">{cinta.length} rollos</p>
    </div>

    <div class="hoja">
      {cinta.map((cuadro, i) => (
        <Cuadro cuadro={cuadro} posicion={i + 1} />
      ))}
    </div>
  </main>
</BaseLayout>
