---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { media, srcset, medidaDe, altDe } from '../../lib/media';
import { oficio } from '../../lib/archivo';
import Lupa from '../../components/Lupa.astro';
import { grafo, persona, imagen, migas, ID_PERSONA, SITIO } from '../../lib/seo';
import '../../styles/sofia-max.css';

export async function getStaticPaths() {
  const proyectos = (await getCollection('projects')).sort(
    (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
  );

  return proyectos.map((proyecto, i) => ({
    params: { slug: proyecto.id },
    props: {
      proyecto,
      anterior: proyectos[i - 1] ?? null,
      siguiente: proyectos[i + 1] ?? null,
    },
  }));
}

interface Props {
  proyecto: CollectionEntry<'projects'>;
  anterior: CollectionEntry<'projects'> | null;
  siguiente: CollectionEntry<'projects'> | null;
}

const { proyecto, anterior, siguiente } = Astro.props;
const { data } = proyecto;
const { Content } = await render(proyecto);
const esSofiaMax = proyecto.id === 'sofia-max';

const tipoSeo: Record<typeof data.type, string> = {
  retrato: 'Retrato fotográfico',
  evento: 'Fotografía de evento',
  comercial: 'Fotografía comercial',
  personal: 'Serie fotográfica',
  concierto: 'Fotografía de concierto',
};
const descripcionTipo: Record<typeof data.type, string> = {
  retrato: 'retrato fotográfico',
  evento: 'cobertura fotográfica de evento',
  comercial: 'fotografía comercial',
  personal: 'serie de fotografía personal',
  concierto: 'fotografía de concierto',
};
const descripcion = `${data.title}: ${descripcionTipo[data.type]} por Von Diego${data.location ? ` en ${data.location}` : ''}, ${data.year}. Galería completa de ${data.photoCount} fotografías.`;

const piezas = Array.from({ length: data.photoCount }, (_, i) => {
  const nn = String(i + 1).padStart(2, '0');
  const ruta = `${data.photosDir}${data.photosPrefix}-${nn}.jpg`;
  const medida = medidaDe(ruta);
  return {
    nn,
    ruta,
    src: media(ruta),
    conjunto: srcset(ruta),
    w: medida?.[0],
    h: medida?.[1],
    alt: altDe(ruta, `${data.title}, pieza ${i + 1}`),
  };
});

// en el rollo la pieza llega a ~620 px en escritorio y a la ventana en móvil
const SIZES = '(max-width: 47.99rem) 100vw, 620px';

// Sofía Max va decorada hasta el tope, así que el reparto de chispas del fondo
// se calcula aquí con una semilla fija: el mismo build da siempre el mismo
// confeti y nada de esto se decide en el cliente.
const TONOS = ['--s-fucsia', '--s-turquesa', '--s-violeta', '--s-oro', '--s-chicle', '--s-lila'];
const FORMAS = ['estrella', 'lenteja', 'rombo', 'estrella'];

const dado = (() => {
  let semilla = 26082026;
  return () => ((semilla = (semilla * 1664525 + 1013904223) % 4294967296) / 4294967296);
})();

const chispas = Array.from({ length: 54 }, () => ({
  x: +(dado() * 100).toFixed(2),
  y: +(dado() * 100).toFixed(2),
  s: +(0.35 + dado() * 1.75).toFixed(2),
  r: Math.round(dado() * 360),
  d: +(dado() * 7).toFixed(2),
  tono: TONOS[Math.floor(dado() * TONOS.length)],
  forma: FORMAS[Math.floor(dado() * FORMAS.length)],
}));

// Rellenos de la secuencia. Cada uno tiene su celda propia en la retícula, así
// que ocupan el hueco que ninguna lámina usa y jamás caen encima de una foto.
const notas: { tras: number; clase: string; texto?: string }[] = [
  { tras: 2, clase: 'sofia-nota--n1', texto: `${data.photosPrefix} · ${data.year}` },
  { tras: 2, clase: 'sofia-nota--n2' },
  { tras: 5, clase: 'sofia-nota--n3' },
  { tras: 6, clase: 'sofia-nota--n4' },
  { tras: 9, clase: 'sofia-nota--n5', texto: 'flash directo' },
  { tras: 9, clase: 'sofia-nota--n6', texto: 'lentejuela · malla · calcomanía' },
];

const esquema = grafo(
  persona(),
  {
    '@type': 'ImageGallery',
    '@id': `${SITIO}/obra/${proyecto.id}/#rollo`,
    name: data.title,
    description: descripcion,
    datePublished: data.publishedAt.toISOString().slice(0, 10),
    inLanguage: 'es-MX',
    creator: { '@id': ID_PERSONA },
    ...(data.location ? { contentLocation: { '@type': 'Place', name: data.location } } : {}),
    ...(data.client ? { sourceOrganization: { '@type': 'Organization', name: data.client } } : {}),
    numberOfItems: data.photoCount,
    image: piezas.map((pieza) => imagen(pieza.ruta, pieza.alt)),
  },
  migas([
    { nombre: 'inicio', ruta: '/' },
    { nombre: 'archivo', ruta: '/obra/' },
    { nombre: data.title.toLowerCase(), ruta: `/obra/${proyecto.id}/` },
  ])
);
---

<BaseLayout
  title={`${data.title} | ${tipoSeo[data.type]}`}
  description={descripcion}
  esquema={esquema}
  image={data.poster}
  imageWidth={data.posterWidth}
  imageHeight={data.posterHeight}
  imageAlt={altDe(data.poster, `${data.title} — rollo de ${oficio[data.type]}, ${data.year}`)}
  precargar={piezas[0]?.ruta}
  precargarSrcset={piezas[0]?.conjunto}
  precargarSizes={esSofiaMax ? '(max-width: 47.99rem) 90vw, 66vw' : SIZES}
>
  <main class:list={['contenedor', 'rollo', { 'rollo--sofia-max': esSofiaMax }]} id="hoja">
    {esSofiaMax ? (
      <>
        {/* El vergo de glitter: capas fijas, detrás de todo. Ninguna toca una foto. */}
        <div class="sofia-fondo" aria-hidden="true">
          <span class="sofia-capa sofia-capa--aurora"></span>
          <span class="sofia-capa sofia-capa--polvo"></span>
          <span class="sofia-capa sofia-capa--lentejuela"></span>
          <span class="sofia-capa sofia-capa--estrellas"></span>
          <span class="sofia-capa sofia-capa--holo"></span>
        </div>

        <section class="sofia-apertura" aria-labelledby="sofia-titulo">
          <span class="sofia-guirnalda" aria-hidden="true"></span>

          <div class="sofia-rotulo">
            <p class="sofia-antetitulo" data-nosnippet aria-hidden="true">archivo · fucsia · 12 piezas</p>
            <h1 class="sofia-titulo" id="sofia-titulo">
              <span class="sofia-titulo-eco" aria-hidden="true">{data.title}</span>
              <span class="sofia-titulo-cara">{data.title}</span>
            </h1>
            <p class="sofia-lema" data-nosnippet>brillo · plástico · calcomanía · flash</p>
          </div>

          <div class="sofia-marco">
            <span class="sofia-cinta-adhesiva" aria-hidden="true"></span>
            <span class="sofia-esquina sofia-esquina--ne" aria-hidden="true"></span>
            <span class="sofia-esquina sofia-esquina--no" aria-hidden="true"></span>
            <span class="sofia-esquina sofia-esquina--se" aria-hidden="true"></span>
            <span class="sofia-esquina sofia-esquina--so" aria-hidden="true"></span>

            <div class="sofia-passe">
              <button
                type="button"
                class="sofia-portada"
                data-lupa-src={piezas[0].src}
                data-lupa-alt={piezas[0].alt}
                aria-label={`Abrir ${piezas[0].alt} a pantalla completa`}
              >
                <img
                  src={piezas[0].src}
                  srcset={piezas[0].conjunto}
                  sizes="(max-width: 47.99rem) 90vw, 66vw"
                  alt={piezas[0].alt}
                  width={piezas[0].w}
                  height={piezas[0].h}
                  loading="eager"
                  decoding="async"
                  fetchpriority="high"
                />
              </button>
            </div>
          </div>

          <p class="sofia-portada-registro"><span data-nosnippet>retrato · 26.08.2026 · 01/12</span></p>
          <span class="sofia-guirnalda sofia-guirnalda--baja" aria-hidden="true"></span>
        </section>

        <div class="sofia-marquesina" aria-hidden="true" data-nosnippet>
          <div class="sofia-marquesina-pista">
            <span>sofía max ★ brillo ★ plástico ★ calcomanía ★ flash ★ fucsia ★ lentejuela ★ malla ★&nbsp;</span>
            <span>sofía max ★ brillo ★ plástico ★ calcomanía ★ flash ★ fucsia ★ lentejuela ★ malla ★&nbsp;</span>
          </div>
        </div>

        <section class="sofia-ficha" aria-label="Ficha del rollo">
          <div class="sofia-ficha-voz">
            <span class="sofia-racimo" aria-hidden="true"></span>
            <div class="voz"><Content /></div>
          </div>

          <dl class="registro micro">
            <div data-nosnippet><dt>rollo</dt> <dd>{data.photosPrefix}</dd></div>
            <div data-nosnippet><dt>oficio</dt> <dd>{oficio[data.type]}</dd></div>
            <div data-nosnippet><dt>año</dt> <dd>{data.year}</dd></div>
            <div data-nosnippet><dt>piezas</dt> <dd>{data.photoCount}</dd></div>
          </dl>
        </section>

        <section class="sofia-secuencia" aria-labelledby="sofia-secuencia-titulo">
          <h2 class="fuera" id="sofia-secuencia-titulo">Secuencia completa</h2>

          {/* Confeti del fondo: va debajo de las láminas, nunca sobre ellas. */}
          <div class="sofia-confeti" aria-hidden="true">
            {chispas.map((chispa) => (
              <span
                class:list={['sofia-chispa', `sofia-chispa--${chispa.forma}`]}
                style={`--x:${chispa.x};--y:${chispa.y};--s:${chispa.s};--r:${chispa.r};--d:${chispa.d};--c:var(${chispa.tono})`}
              ></span>
            ))}
          </div>

          {piezas.slice(1).map((pieza, i) => (
            <>
              <figure class="sofia-lamina">
                <div class="sofia-marco sofia-marco--lamina">
                  <span class="sofia-esquina sofia-esquina--no" aria-hidden="true"></span>
                  <span class="sofia-esquina sofia-esquina--se" aria-hidden="true"></span>

                  <div class="sofia-passe">
                    <button
                      type="button"
                      class="sofia-foto"
                      data-lupa-src={pieza.src}
                      data-lupa-alt={pieza.alt}
                      aria-label={`Abrir ${pieza.alt} a pantalla completa`}
                    >
                      <img
                        src={pieza.src}
                        srcset={pieza.conjunto}
                        sizes="(max-width: 39.99rem) 90vw, 60vw"
                        alt={pieza.alt}
                        width={pieza.w}
                        height={pieza.h}
                        loading="lazy"
                        decoding="async"
                      />
                    </button>
                  </div>
                </div>

                <figcaption>
                  <span data-nosnippet>{data.photosPrefix} {pieza.nn}</span>
                  <span data-nosnippet>{pieza.nn}/{data.photoCount}</span>
                </figcaption>
              </figure>

              {notas
                .filter((nota) => nota.tras === i + 1)
                .map((nota) => (
                  <div class:list={['sofia-nota', nota.clase]} aria-hidden="true" data-nosnippet>
                    {nota.texto && <span class="sofia-nota-texto">{nota.texto}</span>}
                  </div>
                ))}
            </>
          ))}
        </section>
      </>
    ) : (
      <>
        <header class="rollo-cab">
          <div>
            <h1 class="display rollo-titulo">{data.title}</h1>
            <div class="voz rollo-texto"><Content /></div>
          </div>

          <dl class="registro micro">
            <div data-nosnippet><dt>rollo</dt> <dd>{data.photosPrefix}</dd></div>
            <div data-nosnippet><dt>oficio</dt> <dd>{oficio[data.type]}</dd></div>
            <div data-nosnippet><dt>año</dt> <dd>{data.year}</dd></div>
            {data.location && <div data-nosnippet><dt>lugar</dt> <dd>{data.location.toLowerCase()}</dd></div>}
            {data.client && <div data-nosnippet><dt>cliente</dt> <dd>{data.client.toLowerCase()}</dd></div>}
            <div data-nosnippet><dt>piezas</dt> <dd>{data.photoCount}</dd></div>
          </dl>
        </header>

        <div class="hoja hoja--intrinseca rollo-hoja">
          {piezas.map((pieza, i) => (
            <button
              type="button"
              class="cuadro"
              data-lupa-src={pieza.src}
              data-lupa-alt={pieza.alt}
              aria-label={`Abrir ${pieza.alt} a pantalla completa`}
            >
              <span class="cuadro-media">
                <img
                  src={pieza.src}
                  srcset={pieza.conjunto}
                  sizes={SIZES}
                  alt={pieza.alt}
                  width={pieza.w}
                  height={pieza.h}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  fetchpriority={i === 0 ? 'high' : undefined}
                />
              </span>
              <span class="cuadro-pie">
                <span class="cuadro-codigo">
                  <span data-nosnippet>{data.photosPrefix} {pieza.nn}</span>
                  <span data-nosnippet>de {data.photoCount}</span>
                </span>
              </span>
            </button>
          ))}
        </div>
      </>
    )}

    <nav class="paso" aria-label="Rollos vecinos">
      {anterior ? (
        <a href={`/obra/${anterior.id}/`}>
          <span class="edge" data-nosnippet>rollo anterior</span>
          <span class="paso-titulo" data-nosnippet>{anterior.data.title.toLowerCase()}</span>
        </a>
      ) : <span />}

      {siguiente ? (
        <a href={`/obra/${siguiente.id}/`}>
          <span class="edge" data-nosnippet>rollo siguiente</span>
          <span class="paso-titulo" data-nosnippet>{siguiente.data.title.toLowerCase()}</span>
        </a>
      ) : <span />}
    </nav>
  </main>

  <Lupa />

  <script>
    import { montarLupa } from '../../lib/lupa';

    // en un rollo el grupo es el rollo entero
    montarLupa({
      grupoDe: () =>
        Array.from(document.querySelectorAll<HTMLButtonElement>('[data-lupa-src]')),
    });
  </script>
</BaseLayout>
