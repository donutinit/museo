---
import BaseLayout from '../layouts/BaseLayout.astro';
import { grafo, persona, migas, SITIO, ID_PERSONA, CORREO } from '../lib/seo';

const esquema = grafo(
  persona(),
  {
    '@type': 'ContactPage',
    '@id': `${SITIO}/contact/#contacto`,
    name: 'Contacto de Von Diego',
    description: 'Contacto directo para fotografía, retrato, eventos, documentación y producción de video en Monterrey.',
    inLanguage: 'es-MX',
    mainEntity: { '@id': ID_PERSONA },
    significantLink: `mailto:${CORREO}`,
  },
  migas([
    { nombre: 'inicio', ruta: '/' },
    { nombre: 'contacto', ruta: '/contact/' },
  ])
);
---

<BaseLayout
  title="Contacto para fotografía y video en Monterrey"
  description="Contacto directo con Von Diego para fotografía de retrato, eventos, documentación y producción de video en Monterrey, Nuevo León."
  esquema={esquema}
>
  <main class="contenedor nota" id="hoja">
    <h1 class="display nota-titulo">una dirección basta</h1>
    <a class="direccion" href="mailto:contacto@vondiego.com">contacto@vondiego.com</a>

    <div class="nota-cuerpo">
      <div class="voz">
        <p>
          Para obra, documentación, video, retrato o una conversación concreta.
          Si hay algo que decir, escríbelo directo.
        </p>
        <p>No hay formulario. No hay embudo. No hay teatro.</p>
      </div>

      <dl class="registro micro">
        <div data-nosnippet><dt>base</dt> <dd>monterrey, mx</dd></div>
        <div data-nosnippet><dt>respuesta</dt> <dd>días hábiles</dd></div>
        <div data-nosnippet><dt>salida</dt> <dd>foto, video, archivo</dd></div>
      </dl>
    </div>

    <nav class="paso" aria-label="Salida">
      <a href="/obra/">
        <span class="edge" data-nosnippet>archivo</span>
        <span class="paso-titulo" data-nosnippet>los rollos completos</span>
      </a>
      <a href="/about/">
        <span class="edge" data-nosnippet>manifiesto</span>
        <span class="paso-titulo" data-nosnippet>lo que sostiene la obra</span>
      </a>
    </nav>
  </main>
</BaseLayout>
