---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CintaPlayer from '../../components/CintaPlayer.astro';
import { cintasPorFecha, kindLabel, subtitulosDe } from '../../data/videos';
import { media, medidaDe } from '../../lib/media';
import { medidaCinta } from '../../lib/archivo';
import { descripcionCinta, grafo, persona, cinta as cintaLD, migas, tipoCintaSeo } from '../../lib/seo';

export async function getStaticPaths() {
  // el mismo orden que la hoja de /obra#cintas: si ahí una cinta va después de
  // otra, aquí "siguiente" tiene que llevar a esa misma
  return cintasPorFecha.map((cinta, i) => ({
    params: { slug: cinta.slug },
    props: {
      cinta,
      anterior: cintasPorFecha[i - 1] ?? null,
      siguiente: cintasPorFecha[i + 1] ?? null,
    },
  }));
}

const { cinta, anterior, siguiente } = Astro.props;
const titulo = cinta.title.toLowerCase();
const [pw, ph] = medidaDe(cinta.poster) ?? medidaCinta(cinta.aspect);
const oficio = kindLabel[cinta.kind].toLowerCase();

const esquema = grafo(
  persona(),
  cintaLD(cinta),
  migas([
    { nombre: 'inicio', ruta: '/' },
    { nombre: 'archivo', ruta: '/obra/' },
    { nombre: titulo, ruta: `/video/${cinta.slug}/` },
  ])
);
---

<BaseLayout
  title={`${cinta.title} | ${tipoCintaSeo[cinta.kind]}`}
  description={descripcionCinta(cinta)}
  esquema={esquema}
  image={cinta.poster}
  imageWidth={pw}
  imageHeight={ph}
  imageAlt={`${cinta.title} — ${oficio}, ${cinta.year}`}
  precargar={cinta.poster}
>
  <main class="contenedor video-page" id="hoja">
    <h1 class="fuera">{titulo}</h1>

    <section class="video-page__escena" aria-label={`Proyección: ${cinta.title}`}>
      <CintaPlayer
        slug={cinta.slug}
        title={cinta.title}
        src={media(cinta.src)}
        poster={media(cinta.poster)}
        captions={subtitulosDe(cinta.slug)}
        durationLabel={cinta.durationLabel}
        aspect={cinta.aspect}
        captionsBurned={cinta.captionsBurned}
      />

      <button
        class="video-page__abrir edge"
        type="button"
        aria-haspopup="dialog"
        aria-controls="ficha-cinta"
        data-abrir-ficha
      >
        ficha
      </button>
    </section>

    <dialog
      class="video-ficha"
      id="ficha-cinta"
      aria-labelledby="ficha-titulo"
      data-ficha-cinta
    >
      <div class="video-ficha__hoja">
        <header class="rollo-cab rollo-cab--cinta">
          <div>
            <h2 class="display rollo-titulo" id="ficha-titulo" tabindex="-1">{titulo}</h2>
            {cinta.caption && <p class="voz cita">{cinta.caption}</p>}
          </div>

          <dl class="registro micro">
            <div data-nosnippet><dt>cinta</dt> <dd>{cinta.slug}</dd></div>
            <div data-nosnippet><dt>oficio</dt> <dd>{oficio}</dd></div>
            <div data-nosnippet><dt>año</dt> <dd>{cinta.year}</dd></div>
            <div data-nosnippet><dt>corre</dt> <dd>{cinta.durationLabel}</dd></div>
            <div data-nosnippet><dt>cuadro</dt> <dd>{cinta.aspect}</dd></div>
            <div data-nosnippet><dt>formato</dt> <dd>h.264 aac</dd></div>
          </dl>
        </header>

        <nav class="paso" aria-label="Cintas vecinas">
          {anterior ? (
            <a href={`/video/${anterior.slug}/`}>
              <span class="edge" data-nosnippet>cinta anterior</span>
              <span class="paso-titulo" data-nosnippet>{anterior.title.toLowerCase().split(/\s+—\s+/)[0]}</span>
            </a>
          ) : <span />}

          {siguiente ? (
            <a href={`/video/${siguiente.slug}/`}>
              <span class="edge" data-nosnippet>cinta siguiente</span>
              <span class="paso-titulo" data-nosnippet>{siguiente.title.toLowerCase().split(/\s+—\s+/)[0]}</span>
            </a>
          ) : <span />}
        </nav>

        <button class="video-ficha__cerrar edge" type="button" data-cerrar-ficha>
          cerrar
        </button>
      </div>
    </dialog>
  </main>

  <script>
    import { velar, dormir } from '../../lib/vela';

    // mientras corre la cinta, la pantalla no se apaga
    const cinta = document.querySelector('video');
    cinta?.addEventListener('play', velar);
    cinta?.addEventListener('pause', dormir);
    cinta?.addEventListener('ended', dormir);

    const ficha = document.querySelector<HTMLDialogElement>('[data-ficha-cinta]');
    const abrirFicha = document.querySelector<HTMLButtonElement>('[data-abrir-ficha]');
    const cerrarFicha = document.querySelector<HTMLButtonElement>('[data-cerrar-ficha]');
    const tituloFicha = document.querySelector<HTMLElement>('#ficha-titulo');

    const abrir = () => {
      if (!ficha || ficha.open) return;
      cinta?.pause();
      ficha.showModal();
      window.requestAnimationFrame(() => tituloFicha?.focus({ preventScroll: true }));
    };

    abrirFicha?.addEventListener('click', abrir);
    cerrarFicha?.addEventListener('click', () => ficha?.close());
    ficha?.addEventListener('click', (evento) => {
      if (evento.target === ficha) ficha.close();
    });
    ficha?.addEventListener('close', () => abrirFicha?.focus({ preventScroll: true }));

    if (window.location.hash === '#ficha') abrir();
  </script>
</BaseLayout>
