---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { cintasPorFecha, kindLabel } from '../../data/videos';
import { media } from '../../lib/media';
import { medidaCinta } from '../../lib/archivo';

export async function getStaticPaths() {
  // el mismo orden que la hoja de /obra#cintas: si ahí una cinta va después de
  // otra, aquí "siguiente" tiene que llevar a esa misma
  return cintasPorFecha.map((cinta, i) => ({
    params: { slug: cinta.slug },
    props: {
      cinta,
      anterior: cintasPorFecha[i - 1] ?? null,
      siguiente: cintasPorFecha[i + 1] ?? null,
    },
  }));
}

const { cinta, anterior, siguiente } = Astro.props;
const titulo = cinta.title.toLowerCase();
const [pw, ph] = medidaCinta(cinta.aspect);
---

<BaseLayout
  title={cinta.title}
  description={cinta.caption ?? `${cinta.title} — cinta del archivo de Von Diego.`}
  image={cinta.poster}
  imageWidth={pw}
  imageHeight={ph}
  imageAlt={`${cinta.title} — ${kindLabel[cinta.kind].toLowerCase()}, ${cinta.year}`}
>
  <main class="contenedor rollo" id="hoja">
    <div class="visor" style={`--cuadro-aspect: ${cinta.aspect};`}>
      <video controls playsinline preload="metadata" poster={media(cinta.poster)}>
        <source src={media(cinta.src)} type="video/mp4" />
        Tu navegador no puede reproducir esta cinta.
      </video>
    </div>

    <header class="rollo-cab rollo-cab--cinta">
      <div>
        <h1 class="display rollo-titulo">{titulo}</h1>
        {cinta.caption && <p class="voz cita">{cinta.caption}</p>}
      </div>

      <dl class="registro micro">
        <div><dt>cinta</dt> <dd>{cinta.slug}</dd></div>
        <div><dt>oficio</dt> <dd>{kindLabel[cinta.kind].toLowerCase()}</dd></div>
        <div><dt>año</dt> <dd>{cinta.year}</dd></div>
        <div><dt>corre</dt> <dd>{cinta.durationLabel}</dd></div>
        <div><dt>cuadro</dt> <dd>{cinta.aspect}</dd></div>
        <div><dt>formato</dt> <dd>h.264 aac</dd></div>
      </dl>
    </header>

    <nav class="paso" aria-label="Cintas vecinas">
      {anterior ? (
        <a href={`/video/${anterior.slug}`}>
          <span class="edge">cinta anterior</span>
          <span class="paso-titulo">{anterior.title.toLowerCase().split(/\s+—\s+/)[0]}</span>
        </a>
      ) : <span />}

      {siguiente ? (
        <a href={`/video/${siguiente.slug}`}>
          <span class="edge">cinta siguiente</span>
          <span class="paso-titulo">{siguiente.title.toLowerCase().split(/\s+—\s+/)[0]}</span>
        </a>
      ) : <span />}
    </nav>
  </main>

  <script>
    import { velar, dormir } from '../../lib/vela';

    // mientras corre la cinta, la pantalla no se apaga
    const cinta = document.querySelector('video');
    cinta?.addEventListener('play', velar);
    cinta?.addEventListener('pause', dormir);
    cinta?.addEventListener('ended', dormir);
  </script>
</BaseLayout>
