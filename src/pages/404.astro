---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404" description="Esta ruta no tiene registro.">
  <main class="contenedor nota" id="hoja">
    <h1 class="display nota-titulo">este cuadro salió velado</h1>
    <p class="voz cabecera-voz">La ruta existe, el registro no. Pasa: se vela un cuadro y se sigue con el rollo.</p>

    <nav class="paso" aria-label="Salida">
      <a href="/">
        <span class="edge">portada</span>
        <span class="paso-titulo">la hoja</span>
      </a>
      <a href="/obra/">
        <span class="edge">archivo</span>
        <span class="paso-titulo">los rollos completos</span>
      </a>
    </nav>
  </main>
</BaseLayout>
