---
import BaseLayout from '../layouts/BaseLayout.astro';
import { grafo, persona, migas, SITIO, ID_PERSONA } from '../lib/seo';

const esquema = grafo(
  persona(),
  {
    '@type': 'ProfilePage',
    '@id': `${SITIO}/about/#manifiesto`,
    name: 'Manifiesto',
    inLanguage: 'es-MX',
    mainEntity: { '@id': ID_PERSONA },
  },
  migas([
    { nombre: 'inicio', ruta: '/' },
    { nombre: 'manifiesto', ruta: '/about/' },
  ])
);
---

<BaseLayout
  title="manifiesto"
  description="Manifiesto de Von Diego: foto, video y montaje desde Monterrey, MX."
  esquema={esquema}
>
  <main class="contenedor nota" id="hoja">
    <h1 class="display nota-titulo">una imagen que sabe cuándo callarse</h1>

    <div class="nota-cuerpo">
      <div class="voz">
        <p>
          Trabajo con imagen fija y en movimiento. No me interesa que todo explique
          demasiado; me interesa que cada pieza encuentre su temperatura.
        </p>
        <p>
          La cámara no está para decorar. Está para decidir qué se queda, qué se corta
          y qué tarda en aparecer.
        </p>
        <p>
          Una hoja de contacto no oculta los descartes: enseña el rollo completo.
          Así está armado este archivo, rollo por rollo, sin recortar nada para que
          cuadre en la página.
        </p>
        <p>
          Antes que programador, artista. El código solamente es otra cámara.
        </p>
      </div>

      <dl class="registro micro">
        <div><dt>oficio</dt> <dd>foto, video, montaje</dd></div>
        <div><dt>base</dt> <dd>monterrey, mx</dd></div>
        <div><dt>archivo</dt> <dd>obra, encargo, cinta</dd></div>
        <div><dt>correo</dt> <dd>contacto@vondiego.com</dd></div>
      </dl>
    </div>

    <nav class="paso" aria-label="Salida">
      <a href="/obra">
        <span class="edge">archivo</span>
        <span class="paso-titulo">los rollos completos</span>
      </a>
      <a href="/contact">
        <span class="edge">contacto</span>
        <span class="paso-titulo">escribir</span>
      </a>
    </nav>
  </main>
</BaseLayout>
