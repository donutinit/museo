---
import BaseLayout from '../layouts/BaseLayout.astro';
import { placas } from '../data/reel';
import { cintaPorSlug, subtitulosDe } from '../data/videos';
import { media, srcset, altDe } from '../lib/media';
import Lupa from '../components/Lupa.astro';
import { grafo, persona, sitio, cinta as cintaLD } from '../lib/seo';

// el póster de la primera placa es lo que manda en el primer pintado
const primeraCinta = cintaPorSlug(
  (placas.find((p) => p.kind === 'video') as { slug: string }).slug
);

// en el carrusel la lámina no pasa de ~500 px de ancho en escritorio
const SIZES = '(max-width: 47.99rem) 100vw, 500px';

// las cintas del reel, para que Google las vea aunque el video se monte con JS
const esquema = grafo(
  persona(),
  sitio(),
  ...placas.filter((p) => p.kind === 'video').map((p) => cintaLD(cintaPorSlug(p.slug)))
);
---

<BaseLayout
  desnudo
  description="Portafolio de Von Diego, fotógrafo y videasta en Monterrey: retrato, documentación, eventos, obra personal y producción de video."
  precargar={primeraCinta.poster}
  esquema={esquema}
>
  <div class="gate" data-gate data-nosnippet role="dialog" aria-modal="true" aria-labelledby="gate-titulo">
    <div class="gate-in">
      <p class="edge">von diego / archivo</p>
      <a id="gate-titulo" class="gate-boton" data-gate-boton href="/obra/">
        <span class="gate-pregunta">¿estás listo?</span>
        <span class="gate-accion">
          <span class="gate-accion--movil">tócame</span>
          <span class="gate-accion--fina">clickeame</span>
        </span>
      </a>
    </div>
  </div>

  <a href="/obra/" class="saltar-reel edge" data-detras-gate inert><span data-nosnippet>saltar al archivo</span></a>

  <div class="mandos" data-detras-gate data-nosnippet inert>
    <button type="button" class="mando edge" data-pausa aria-pressed="false">
      <span data-pausa-label>pausa</span>
    </button>
    <button
      type="button"
      class="mando edge"
      data-subtitulos
      data-on="true"
      aria-pressed="true"
      aria-label="Ocultar subtítulos"
    >
      <span class="sonido-punto" aria-hidden="true"></span>
      <span data-subtitulos-label>subtítulos on</span>
    </button>
    <button
      type="button"
      class="mando edge"
      data-sonido
      data-on="false"
      aria-pressed="false"
      aria-label="Activar sonido"
    >
      <span class="sonido-punto" aria-hidden="true"></span>
      <span data-sonido-label>sonido off</span>
    </button>
  </div>

  <Lupa />

  <main data-detras-gate inert>
    <h1 class="fuera">Von Diego — archivo de foto y video, Monterrey</h1>

    {placas.map((placa, i) => {
      if (placa.kind === 'final') {
        return (
          <section class="placa placa--final" data-placa={i}>
            <div class="placa-copia">
              <p class="edge"><span data-nosnippet>{placa.code}</span></p>
              <h2 class="placa-linea">
                <em>{placa.line}</em> {placa.lineEm}.
              </h2>
              <nav class="placa-salida">
                <a class="direccion" href="/obra/"><span data-nosnippet>revisar la obra completa</span></a>
                <a class="edge" href="/contact/"><span data-nosnippet>contacto@vondiego.com</span></a>
              </nav>
            </div>
          </section>
        );
      }

      if (placa.kind === 'grid') {
        return (
          <section class="placa placa--carrusel" data-placa={i}>
            <header class="placa-copia">
              <p class="placa-codigo edge">
                <span data-nosnippet>{placa.code}</span>
                <span data-nosnippet>{placa.caption}</span>
                <span data-nosnippet>{placa.photos.length} piezas</span>
              </p>
              <h2 class="placa-titulo display">
                {placa.title} <em>{placa.titleEm}</em>.
              </h2>
            </header>

            <div class="carrusel" data-carrusel>
              {placa.photos.map((foto) => (
                <button
                  type="button"
                  class="carrusel-lamina"
                  data-lupa-src={media(foto.src)}
                  data-lupa-alt={altDe(foto.src, foto.alt)}
                  aria-label={`Abrir ${altDe(foto.src, foto.alt)} en grande`}
                  style={`--ratio: ${(foto.width / foto.height).toFixed(5)};`}
                >
                  <img
                    src={media(foto.src)}
                    srcset={srcset(foto.src)}
                    sizes={SIZES}
                    alt=""
                    width={foto.width}
                    height={foto.height}
                    loading="lazy"
                    decoding="async"
                  />
                </button>
              ))}
            </div>

            <ol class="carrusel-puntos" data-carrusel-puntos aria-hidden="true">
              {placa.photos.map(() => <li></li>)}
            </ol>
          </section>
        );
      }

      const cinta = cintaPorSlug(placa.slug);
      const razon = cinta.aspect === '16/9' ? 1.7778 : cinta.aspect === '4/3' ? 1.3333 : 0.5625;

      return (
        <section
          class="placa placa--cinta"
          data-placa={i}
          data-girar={placa.girar ? 'true' : undefined}
          style={`--aspect: ${cinta.aspect}; --razon: ${razon};`}
        >
          <div class="placa-lecho">
            <video
              data-placa-video
              loop
              muted
              playsinline
              preload="none"
              poster={media(cinta.poster)}
            >
              <source src={media(cinta.src)} type="video/mp4" />
              <track
                data-placa-track
                kind="captions"
                src={subtitulosDe(cinta.slug)}
                srclang="es"
                label="Español"
              />
            </video>
            <p class="placa-subtitulo" data-placa-subtitulo></p>
          </div>

          <div class="placa-copia">
            <p class="placa-codigo edge">
              <span data-nosnippet>{placa.code}</span>
              <span data-nosnippet>{placa.where}</span>
              <span data-nosnippet>vd / {String(cinta.year).slice(-2)}</span>
              <span data-nosnippet>cinta {cinta.aspect}</span>
            </p>
            <h2 class="placa-linea">
              {placa.line} <em>{placa.lineEm}</em>.
            </h2>
            <a class="placa-ir edge" href={`/video/${cinta.slug}/`}><span data-nosnippet>ver la cinta</span></a>
          </div>

          {i === 0 && (
            <span class="pista edge" data-nosnippet aria-hidden="true">
              <span>desliza</span>
              <span class="pista-flecha">↓</span>
            </span>
          )}
        </section>
      );
    })}
  </main>

  <script>
    import { montarLupa, lupaAbierta } from '../lib/lupa';
    import { aislar, atrapar } from '../lib/foco';
    import { velar, dormir } from '../lib/vela';

    /** El mismo corte que usa el CSS: arriba de esto la placa es retícula. */
    const enRetícula = window.matchMedia('(min-width: 48rem)');
    const quieto = window.matchMedia('(prefers-reduced-motion: reduce)');

    // En escritorio cada retícula debe caber en una pantalla: si rebasa, se
    // reduce con --escala. Una placa que mide la ventana exacta nunca obliga
    // al snap a elegir orilla, y un gesto siempre es una placa completa.
    const ajustarRetículas = () => {
      document.querySelectorAll<HTMLElement>('.placa--carrusel').forEach((placa) => {
        const carrusel = placa.querySelector<HTMLElement>('[data-carrusel]');
        const copia = placa.querySelector<HTMLElement>('.placa-copia');

        if (!enRetícula.matches || !carrusel || !copia) {
          placa.removeAttribute('data-ajustada');
          placa.style.removeProperty('--escala');
          return;
        }

        placa.dataset.ajustada = 'true';
        placa.style.setProperty('--escala', '1');

        const cs = getComputedStyle(placa);
        const disponible =
          placa.clientHeight -
          copia.offsetHeight -
          (parseFloat(cs.paddingTop) || 0) -
          (parseFloat(cs.paddingBottom) || 0) -
          (parseFloat(cs.rowGap) || 0);

        placa.style.setProperty(
          '--escala',
          String(Math.min(1, disponible / carrusel.offsetHeight))
        );
      });
    };

    ajustarRetículas();
    document.fonts?.ready.then(ajustarRetículas);
    window.addEventListener('resize', ajustarRetículas, { passive: true });

    // ── el estado del reel, y el motor que lo mueve ──────────────────────
    // Con movimiento reducido el reel arranca detenido: quien lo quiera
    // corriendo lo prende, en vez de que le caiga encima.
    const estado = {
      listo: false,
      quiereSonido: false,
      faltaGesto: false,
      pausado: quieto.matches,
      subtitulos: true,
    };

    const placasCinta = Array.from(document.querySelectorAll<HTMLElement>('.placa--cinta'));
    const cintas = placasCinta
      .map((p) => p.querySelector<HTMLVideoElement>('[data-placa-video]'))
      .filter((v): v is HTMLVideoElement => Boolean(v));

    const repintarSubtitulos: Array<() => void> = [];
    placasCinta.forEach((placa) => {
      const video = placa.querySelector<HTMLVideoElement>('[data-placa-video]');
      const track = video?.querySelector<HTMLTrackElement>('[data-placa-track]');
      const salida = placa.querySelector<HTMLElement>('[data-placa-subtitulo]');
      if (!track || !salida) return;

      const pista = track.track;
      pista.mode = 'hidden';
      const pintar = () => {
        const texto = estado.subtitulos
          ? Array.from(pista.activeCues ?? [])
              .map((cue) => (cue as VTTCue).text)
              .join('\n')
          : '';
        salida.textContent = texto;
      };
      pista.addEventListener('cuechange', pintar);
      repintarSubtitulos.push(pintar);
    });

    /** Los mandos la reasignan; mientras tanto no pinta nada. */
    let pintarMandos: () => void = () => {};

    const visible = (el: HTMLElement) => {
      const r = el.getBoundingClientRect();
      const vh = window.innerHeight || document.documentElement.clientHeight;
      const vw = window.innerWidth || document.documentElement.clientWidth;
      const h = Math.min(r.bottom, vh) - Math.max(r.top, 0);
      const w = Math.min(r.right, vw) - Math.max(r.left, 0);
      if (h <= 0 || w <= 0 || r.height <= 0 || r.width <= 0) return 0;
      return (h * w) / (r.height * r.width);
    };

    /** La cinta que manda es la más cerca del centro del cuadro. */
    const cintaEnCuadro = () => {
      const centro = (window.innerHeight || document.documentElement.clientHeight) / 2;
      let distancia = Number.POSITIVE_INFINITY;
      let razon = 0;
      let elegida: HTMLVideoElement | null = null;

      placasCinta.forEach((placa) => {
        const video = placa.querySelector<HTMLVideoElement>('[data-placa-video]');
        if (!video) return;
        const r = visible(placa);
        if (r < 0.2) return;
        const caja = placa.getBoundingClientRect();
        const d = Math.abs((caja.top + caja.bottom) / 2 - centro);
        if (!elegida || r > razon + 0.12 || d < distancia) {
          distancia = d;
          razon = r;
          elegida = video;
        }
      });

      return elegida;
    };

    const callarOtras = (menos: HTMLVideoElement | null) => {
      cintas.forEach((otra) => {
        if (otra !== menos) {
          otra.pause();
          otra.muted = true;
        }
      });
    };

    const correr = async (v: HTMLVideoElement, porGesto = false) => {
      if (!estado.listo || estado.pausado) return;
      callarOtras(v);
      v.muted = !estado.quiereSonido;
      if (estado.quiereSonido) v.volume = 1;
      try {
        await v.play();
        velar(); // mientras corre la cinta, la pantalla no se apaga
        if (estado.quiereSonido && !v.muted) {
          estado.faltaGesto = false;
          pintarMandos();
        }
      } catch {
        if (!estado.quiereSonido || porGesto) return;
        estado.faltaGesto = true;
        pintarMandos();
        v.muted = true;
        try { await v.play(); } catch {}
      }
    };

    const sincronizar = (porGesto = false) => {
      if (!estado.listo || estado.pausado || lupaAbierta()) {
        cintas.forEach((v) => v.pause());
        dormir(); // sin cinta en cuadro, la pantalla puede apagarse
        return;
      }
      const siguiente = cintaEnCuadro();
      callarOtras(siguiente);
      if (siguiente) correr(siguiente, porGesto);
      else dormir();
    };

    let cuadroPendiente = 0;
    const agendar = () => {
      if (cuadroPendiente) return;
      cuadroPendiente = window.requestAnimationFrame(() => {
        cuadroPendiente = 0;
        sincronizar();
      });
    };

    // ── el gate: no depende de ningún mando ─────────────────────────────
    const gate = document.querySelector<HTMLElement>('[data-gate]');
    const gateBoton = document.querySelector<HTMLAnchorElement>('[data-gate-boton]');

    if (gate && gateBoton) {
      document.documentElement.style.overflow = 'hidden';
      const soltarFoco = atrapar(gate);
      const soltarAislamiento = aislar(gate);
      gateBoton.focus({ preventScroll: true });

      // Dirección deliberada: sólo en `/`, el gate obtiene el gesto de entrada
      // a la pieza audiovisual y la primera cinta arranca con sonido. No mover
      // este comportamiento a otras rutas; ver AGENTS.md.
      gateBoton.addEventListener('click', (evento) => {
        evento.preventDefault();
        estado.listo = true;
        estado.quiereSonido = true;
        estado.faltaGesto = false;
        const yolanda = cintas[0];
        if (yolanda) {
          yolanda.preload = 'auto';
          yolanda.load();
        }
        soltarFoco();
        soltarAislamiento();
        document.querySelectorAll<HTMLElement>('[data-detras-gate]').forEach((elemento) => {
          elemento.inert = false;
        });
        gate.setAttribute('data-ido', 'true');
        gate.setAttribute('aria-hidden', 'true');
        document.documentElement.style.overflow = '';
        pintarMandos();
        sincronizar(true);
        document.querySelector<HTMLElement>('.saltar-reel')?.focus({ preventScroll: true });
      });
    } else {
      // sin gate no hay gesto que pedir: el reel arranca en cuanto se pueda
      estado.listo = true;
    }

    // ── los mandos: sonido y pausa ──────────────────────────────────────
    const botonSonido = document.querySelector<HTMLButtonElement>('[data-sonido]');
    const etiquetaSonido = document.querySelector<HTMLSpanElement>('[data-sonido-label]');
    const botonPausa = document.querySelector<HTMLButtonElement>('[data-pausa]');
    const etiquetaPausa = document.querySelector<HTMLSpanElement>('[data-pausa-label]');
    const botonSubtitulos = document.querySelector<HTMLButtonElement>('[data-subtitulos]');
    const etiquetaSubtitulos = document.querySelector<HTMLSpanElement>('[data-subtitulos-label]');

    if (botonSonido && etiquetaSonido) {
      pintarMandos = () => {
        botonSonido.setAttribute('aria-pressed', String(estado.quiereSonido));
        botonSonido.setAttribute(
          'aria-label',
          estado.quiereSonido ? 'Silenciar' : 'Activar sonido'
        );
        botonSonido.dataset.on = String(estado.quiereSonido);
        etiquetaSonido.textContent = estado.quiereSonido
          ? estado.faltaGesto
            ? 'toca sonido'
            : 'sonido on'
          : 'sonido off';

        if (botonSubtitulos && etiquetaSubtitulos) {
          botonSubtitulos.setAttribute('aria-pressed', String(estado.subtitulos));
          botonSubtitulos.setAttribute(
            'aria-label',
            estado.subtitulos ? 'Ocultar subtítulos' : 'Mostrar subtítulos'
          );
          botonSubtitulos.dataset.on = String(estado.subtitulos);
          etiquetaSubtitulos.textContent = estado.subtitulos
            ? 'subtítulos on'
            : 'subtítulos off';
        }

        if (botonPausa && etiquetaPausa) {
          botonPausa.setAttribute('aria-pressed', String(estado.pausado));
          botonPausa.setAttribute(
            'aria-label',
            estado.pausado ? 'Reanudar el reel' : 'Detener el reel'
          );
          etiquetaPausa.textContent = estado.pausado ? 'correr' : 'pausa';
        }
      };

      botonSonido.addEventListener('click', () => {
        estado.quiereSonido = !estado.quiereSonido;
        if (!estado.quiereSonido) estado.faltaGesto = false;
        pintarMandos();
        sincronizar(true);
      });
    }

    botonSubtitulos?.addEventListener('click', () => {
      estado.subtitulos = !estado.subtitulos;
      pintarMandos();
      repintarSubtitulos.forEach((pintar) => pintar());
    });

    // WCAG 2.2.2: algo que se mueve solo y no para necesita cómo pararlo.
    botonPausa?.addEventListener('click', () => {
      estado.pausado = !estado.pausado;
      pintarMandos();
      sincronizar(true);
    });

    const observador = new IntersectionObserver(agendar, {
      threshold: [0, 0.2, 0.45, 0.7, 1],
    });
    placasCinta.forEach((p) => observador.observe(p));

    cintas.forEach((v) => v.addEventListener('play', () => callarOtras(v)));

    const reintentar = () => {
      if (!estado.listo || estado.pausado || !estado.quiereSonido || lupaAbierta()) return;
      sincronizar(true);
    };

    window.addEventListener('pointerdown', reintentar);
    window.addEventListener('touchend', reintentar, { passive: true });
    window.addEventListener('keydown', reintentar);
    window.addEventListener('scroll', agendar, { passive: true });
    window.addEventListener('resize', agendar, { passive: true });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        cintas.forEach((v) => v.pause());
        dormir();
      } else agendar();
    });

    pintarMandos();
    cintas.forEach((v) => v.pause());

    // los puntitos siguen a la lámina encuadrada en cada carrusel del feed
    document.querySelectorAll<HTMLElement>('[data-carrusel]').forEach((carrusel) => {
      const puntos = carrusel.parentElement?.querySelector<HTMLElement>('[data-carrusel-puntos]');
      if (!puntos) return;

      const laminas = puntos.querySelectorAll<HTMLElement>('li');
      let midiendo = 0;

      const pintar = () => {
        if (carrusel.clientWidth === 0) return;
        const i = Math.round(carrusel.scrollLeft / carrusel.clientWidth);
        laminas.forEach((punto, k) => { punto.dataset.activo = String(k === i); });
      };

      carrusel.addEventListener('scroll', () => {
        if (midiendo) return;
        midiendo = window.requestAnimationFrame(() => { midiendo = 0; pintar(); });
      }, { passive: true });

      pintar();
    });

    // En cualquier ancho el clic abre la foto; en móvil el visor también se
    // puede recorrer con el dedo.
    montarLupa({
      grupoDe: (boton) =>
        Array.from(
          boton.closest('.carrusel')?.querySelectorAll<HTMLButtonElement>('[data-lupa-src]') ?? []
        ),
      alAbrir: () =>
        document
          .querySelectorAll<HTMLVideoElement>('[data-placa-video]')
          .forEach((v) => v.pause()),
      alCerrar: () => sincronizar(true),
    });
  </script>
</BaseLayout>
