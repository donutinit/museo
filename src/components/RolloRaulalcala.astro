---
import { render, type CollectionEntry } from 'astro:content';
import { oficio } from '../lib/archivo';
import '../styles/raulalcala.css';

/** Una lámina ya resuelta por la página: medidas, candidatos y alt incluidos. */
interface Pieza {
  nn: string;
  src: string;
  conjunto: string | undefined;
  w?: number;
  h?: number;
  alt: string;
}

interface Props {
  proyecto: CollectionEntry<'projects'>;
  piezas: Pieza[];
  /** La medida de la placa de portada; la misma que precarga la página. */
  sizesCabeza: string;
}

const { proyecto, piezas, sizesCabeza } = Astro.props;
const { data } = proyecto;
const { Content } = await render(proyecto);

// Dorsales reales: los nombran los alts de alt.json (pieza 04 "dorsal 75",
// pieza 05 "dorsal 456", pieza 06 "dorsal 75"). Nada inventado: si el alt
// no lo dice, no va en la lista.
const DORSALES: Record<string, string> = {
  '04': 'dorsal 75',
  '05': 'dorsal 456',
  '06': 'dorsal 75',
};

// Todo el texto suelto sale del frontmatter: código, oficio, lugar, año, cuenta.
const campos = [
  ['rollo', data.photosPrefix],
  ['oficio', oficio[data.type]],
  ...(data.location ? [['lugar', data.location.toLowerCase()]] : []),
  ['año', String(data.year)],
  ['entradas', String(data.photoCount)],
];

const portada = piezas[0];
const secuencia = piezas.slice(1);

const aspectDe = (pieza: Pieza) => (pieza.w ?? 3) / (pieza.h ?? 2);

/**
 * El ancho renderizado de una lámina es `min(columna, alto tope × aspect)`:
 * la altura manda y el ancho sale del aspect real, así que nada se recorta.
 * La lista va en parrilla de dos columnas: el alto tope es ~30rem y la
 * columna llega a ~31rem (apaisadas), de ahí sale el `sizes`.
 */
const sizesLamina = (aspect: number) => {
  const ancho = Math.min(31, 30 * aspect);
  return `(max-width: 55.99rem) 80vw, ${Math.max(1, Math.round(ancho))}rem`;
};
---

{/* el plano del pliego: capas fijas, detrás de todo, ninguna sobre una foto */}
<div class="raulalcala-plano" aria-hidden="true">
  <span class="raulalcala-capa raulalcala-capa--margenes"></span>
  <span class="raulalcala-capa raulalcala-capa--tinta"></span>
</div>

{/* la cabeza de la hoja: sello, titular, registro y el renglón 01 */}
<section class="raulalcala-cabeza" aria-labelledby="raulalcala-titulo">
  <p class="raulalcala-sello raulalcala-rotulo" data-nosnippet>lista de salida · {data.photosPrefix}</p>

  <div class="raulalcala-titular">
    <h1 class="raulalcala-titulo" id="raulalcala-titulo">{data.title}</h1>

    <dl class="registro micro raulalcala-registro">
      {campos.map(([campo, valor]) => (
        <div data-nosnippet><dt>{campo}</dt> <dd>{valor}</dd></div>
      ))}
    </dl>
  </div>

  {/* renglón 01: el primer número de la lista lleva el plano amarillo */}
  <figure class="raulalcala-entrada raulalcala-entrada--cabeza">
    <span class="raulalcala-numeral raulalcala-numeral--plano" aria-hidden="true" data-nosnippet>{portada.nn}</span>
    <div class="raulalcala-cuerpo">
      <div class="raulalcala-mate">
        <button
          type="button"
          class="raulalcala-captura"
          data-lupa-src={portada.src}
          data-lupa-alt={portada.alt}
          aria-label={`Abrir ${portada.alt} a pantalla completa`}
        >
          <img
            src={portada.src}
            srcset={portada.conjunto}
            sizes={sizesCabeza}
            alt={portada.alt}
            width={portada.w}
            height={portada.h}
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </button>
      </div>

      <figcaption class="raulalcala-pie raulalcala-rotulo">
        <span class="raulalcala-dato" data-nosnippet>{data.photosPrefix} {portada.nn}</span>
        <span data-nosnippet>entrada {portada.nn}/{data.photoCount}</span>
      </figcaption>
    </div>
  </figure>
</section>

{/* el texto del rollo, entre el renglón 01 y el resto de la lista */}
<section class="raulalcala-voz-zona" aria-label="El reto">
  <div class="voz"><Content /></div>
</section>

<section class="raulalcala-lista" aria-labelledby="raulalcala-lista-titulo">
  <h2 class="fuera" id="raulalcala-lista-titulo">Lista completa</h2>

  {secuencia.map((pieza) => {
    const dorsal = DORSALES[pieza.nn];
    return (
      <figure class="raulalcala-entrada" style={`--razon:${aspectDe(pieza).toFixed(4)}`}>
        <span class="raulalcala-numeral" aria-hidden="true" data-nosnippet>{pieza.nn}</span>
        <div class="raulalcala-cuerpo">
          <div class="raulalcala-mate">
            <button
              type="button"
              class="raulalcala-captura"
              data-lupa-src={pieza.src}
              data-lupa-alt={pieza.alt}
              aria-label={`Abrir ${pieza.alt} a pantalla completa`}
            >
              <img
                src={pieza.src}
                srcset={pieza.conjunto}
                sizes={sizesLamina(aspectDe(pieza))}
                alt={pieza.alt}
                width={pieza.w}
                height={pieza.h}
                loading="lazy"
                decoding="async"
              />
            </button>
          </div>

          <figcaption class="raulalcala-pie raulalcala-rotulo">
            <span class="raulalcala-dato" data-nosnippet>{data.photosPrefix} {pieza.nn}</span>
            {dorsal && <span class="raulalcala-dorsal" data-nosnippet>{dorsal}</span>}
            <span data-nosnippet>entrada {pieza.nn}/{data.photoCount}</span>
          </figcaption>
        </div>
      </figure>
    );
  })}

  {/* el cierre: una banda de plano amarillo en celda que ninguna entrada ocupa */}
  <div class="raulalcala-cierre" aria-hidden="true" data-nosnippet>
    <span class="raulalcala-cierre-cuenta">{String(data.photoCount).padStart(2, '0')}</span>
    <div class="raulalcala-cierre-col">
      <span class="raulalcala-cierre-rotulo">fin de lista</span>
      <span class="raulalcala-cierre-codigo">{data.photosPrefix} · {data.year}</span>
    </div>
  </div>
</section>
