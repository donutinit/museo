---
type Aspecto = '9/16' | '16/9' | '4/3';
type EstadoPreview =
  | 'default'
  | 'hover'
  | 'focus'
  | 'active'
  | 'disabled'
  | 'loading'
  | 'error'
  | 'success';

interface Props {
  slug: string;
  title: string;
  src: string;
  poster: string;
  captions: string;
  durationLabel: string;
  aspect: Aspecto;
  captionsBurned?: boolean;
  previewState?: EstadoPreview;
  previewCaption?: string;
}

const {
  slug,
  title,
  src,
  poster,
  captions,
  durationLabel,
  aspect,
  captionsBurned = false,
  previewState,
  previewCaption,
} = Astro.props;

const razones: Record<Aspecto, number> = {
  '9/16': 9 / 16,
  '16/9': 16 / 9,
  '4/3': 4 / 3,
};

const estado = previewState === 'loading'
  ? 'loading'
  : previewState === 'error'
    ? 'error'
    : previewState === 'success'
      ? 'ended'
      : 'idle';

const clasePreview = previewState && ['hover', 'focus', 'active', 'disabled'].includes(previewState)
  ? `is-${previewState}`
  : undefined;

const llamada = estado === 'loading'
  ? 'cargando cinta'
  : estado === 'error'
    ? 'intentar de nuevo'
    : estado === 'ended'
      ? 'volver a correr'
      : 'correr cinta';

const detalle = estado === 'error'
  ? 'la cinta no cargó'
  : estado === 'ended'
    ? 'fin de cinta'
    : durationLabel;

const desactivado = previewState === 'disabled';
const visto = previewState === 'success' ? 1 : 0;
const controlId = `cinta-avance-${slug}`;
---

<div
  class:list={['cinta-player', clasePreview]}
  data-cinta-player
  data-state={estado}
  data-controls="visible"
  data-sonido="on"
  data-texto={captionsBurned ? 'burned' : 'on'}
  data-preview={previewState ? 'true' : undefined}
  data-enhanced={previewState ? 'true' : undefined}
  style={`--cinta-aspect: ${aspect}; --cinta-razon: ${razones[aspect]}; --visto: ${visto}; --cargado: ${visto};`}
>
  <video
    class="cinta-player__video"
    controls={!previewState}
    playsinline
    preload="none"
    poster={poster}
    aria-label={`Cinta: ${title}`}
  >
    <source src={src} type="video/mp4" />
    <track
      kind="captions"
      src={captions}
      srclang="es"
      label="Español"
      default={!captionsBurned}
    />
    Tu navegador no puede reproducir esta cinta.
  </video>

  <p class="cinta-player__subtitulo" aria-hidden="true" data-player-subtitulo>{previewCaption}</p>

  <button
    class="cinta-player__lienzo"
    type="button"
    data-player-lienzo
    aria-label={`Reproducir ${title}`}
    aria-keyshortcuts="Space Enter K M C F ArrowLeft ArrowRight"
    disabled={desactivado}
  >
    <span class="cinta-player__llamada" aria-hidden="true">
      <svg class="cinta-player__llamada-icono" viewBox="0 0 20 20" aria-hidden="true">
        <path d="M6 3.75 16 10 6 16.25Z" />
      </svg>
      <span class="cinta-player__llamada-texto" data-player-llamada>{llamada}</span>
      <span class="cinta-player__llamada-detalle" data-player-detalle>{detalle}</span>
    </span>
  </button>

  <div class="cinta-player__velo" aria-hidden="true"></div>

  <div class="cinta-player__mandos" role="group" aria-label={`Controles de ${title}`}>
    <div class="cinta-player__avance">
      <span class="cinta-player__riel" aria-hidden="true">
        <span class="cinta-player__cargado"></span>
        <span class="cinta-player__visto"></span>
      </span>
      <input
        id={controlId}
        class="cinta-player__rango"
        type="range"
        min="0"
        max="1000"
        step="1"
        value={previewState === 'success' ? '1000' : '0'}
        aria-label="Posición de la cinta"
        aria-valuetext={`00:00 de ${durationLabel}`}
        disabled={!previewState || desactivado}
        data-player-rango
      />
    </div>

    <div class="cinta-player__transporte">
      <button
        class="cinta-player__mando cinta-player__mando--principal"
        type="button"
        data-player-toggle
        aria-label={`Reproducir ${title}`}
        disabled={desactivado}
      >
        <svg class="cinta-player__icono cinta-player__icono--reproducir" viewBox="0 0 20 20" aria-hidden="true">
          <path class="cinta-player__icono-play" d="M6 3.75 16 10 6 16.25Z" />
          <path class="cinta-player__icono-pausa" d="M5.5 4h3v12h-3zM11.5 4h3v12h-3z" />
        </svg>
        <span class="cinta-player__mando-palabra" data-player-toggle-label>{estado === 'ended' ? 'otra vez' : 'correr'}</span>
      </button>

      <output class="cinta-player__tiempo" for={controlId} aria-label="Tiempo de reproducción">
        <span data-player-actual>{previewState === 'success' ? durationLabel : '00:00'}</span>
        <span aria-hidden="true">/</span>
        <span data-player-duracion>{durationLabel}</span>
      </output>

      <div class="cinta-player__acciones">
        <button
          class="cinta-player__mando"
          type="button"
          data-player-sonido
          aria-label="Silenciar"
          aria-pressed="true"
          disabled={desactivado}
        >
          <svg class="cinta-player__icono" viewBox="0 0 20 20" aria-hidden="true">
            <path class="cinta-player__trazo" d="M3.5 8h3L10.5 4v12l-4-4h-3zM13 7a4 4 0 0 1 0 6M15 4.75a7 7 0 0 1 0 10.5" />
            <path class="cinta-player__trazo cinta-player__icono-mudo" d="m13.5 7.5 4 5m0-5-4 5" />
          </svg>
          <span class="cinta-player__mando-palabra">sonido</span>
          <span class="cinta-player__estado-punto" aria-hidden="true"></span>
        </button>

        <button
          class="cinta-player__mando"
          type="button"
          data-player-texto
          aria-label="Ocultar subtítulos"
          aria-pressed="true"
          disabled={desactivado}
          hidden={captionsBurned}
        >
          <span class="cinta-player__cc" aria-hidden="true">cc</span>
          <span class="cinta-player__mando-palabra">texto</span>
          <span class="cinta-player__estado-punto" aria-hidden="true"></span>
        </button>

        <button
          class="cinta-player__mando"
          type="button"
          data-player-pantalla
          aria-label="Abrir pantalla completa"
          aria-pressed="false"
          disabled={desactivado}
        >
          <svg class="cinta-player__icono" viewBox="0 0 20 20" aria-hidden="true">
            <path class="cinta-player__trazo" d="M3.5 8V3.5H8M12 3.5h4.5V8M16.5 12v4.5H12M8 16.5H3.5V12" />
          </svg>
          <span class="cinta-player__mando-palabra" data-player-pantalla-label>pantalla</span>
        </button>
      </div>
    </div>
  </div>

  <p class="fuera" aria-live="polite" data-player-live></p>
</div>

<script>
  const CONTROL_IDLE_MS = 2500;

  type VideoPantalla = HTMLVideoElement & {
    webkitEnterFullscreen?: () => void;
  };

  const formatoTiempo = (segundos: number) => {
    if (!Number.isFinite(segundos) || segundos < 0) return '00:00';
    const entero = Math.floor(segundos);
    const horas = Math.floor(entero / 3600);
    const minutos = Math.floor((entero % 3600) / 60);
    const segundosRestantes = entero % 60;
    return horas > 0
      ? `${horas}:${String(minutos).padStart(2, '0')}:${String(segundosRestantes).padStart(2, '0')}`
      : `${String(minutos).padStart(2, '0')}:${String(segundosRestantes).padStart(2, '0')}`;
  };

  document.querySelectorAll<HTMLElement>('[data-cinta-player]').forEach((player) => {
    if (player.dataset.preview === 'true' || player.dataset.iniciado === 'true') return;

    const video = player.querySelector<VideoPantalla>('video');
    const lienzo = player.querySelector<HTMLButtonElement>('[data-player-lienzo]');
    const toggle = player.querySelector<HTMLButtonElement>('[data-player-toggle]');
    const toggleLabel = player.querySelector<HTMLElement>('[data-player-toggle-label]');
    const rango = player.querySelector<HTMLInputElement>('[data-player-rango]');
    const actual = player.querySelector<HTMLElement>('[data-player-actual]');
    const duracion = player.querySelector<HTMLElement>('[data-player-duracion]');
    const llamada = player.querySelector<HTMLElement>('[data-player-llamada]');
    const detalle = player.querySelector<HTMLElement>('[data-player-detalle]');
    const sonido = player.querySelector<HTMLButtonElement>('[data-player-sonido]');
    const texto = player.querySelector<HTMLButtonElement>('[data-player-texto]');
    const pantalla = player.querySelector<HTMLButtonElement>('[data-player-pantalla]');
    const pantallaLabel = player.querySelector<HTMLElement>('[data-player-pantalla-label]');
    const mandos = player.querySelector<HTMLElement>('.cinta-player__mandos');
    const subtitulo = player.querySelector<HTMLElement>('[data-player-subtitulo]');
    const vivo = player.querySelector<HTMLElement>('[data-player-live]');
    const pista = video?.textTracks[0];
    const textoQuemado = player.dataset.texto === 'burned';

    if (
      !video || !lienzo || !toggle || !toggleLabel || !rango || !actual ||
      !duracion || !llamada || !detalle || !sonido || !texto || !pantalla ||
      !pantallaLabel || !mandos || !subtitulo || !vivo
    ) return;

    let ocultarMandos = 0;
    let cuadro = 0;
    let segundoPintado = -1;
    let sobreMandos = false;
    let arrastrando = false;
    let pantallaNativa = false;

    const anunciar = (mensaje: string) => { vivo.textContent = mensaje; };

    const mostrarMandos = (ocultarDespues = false) => {
      window.clearTimeout(ocultarMandos);
      player.dataset.controls = 'visible';
      if (
        ocultarDespues &&
        player.dataset.state === 'playing' &&
        !sobreMandos &&
        !arrastrando &&
        !player.matches(':focus-within')
      ) {
        ocultarMandos = window.setTimeout(() => {
          if (
            player.dataset.state === 'playing' &&
            !sobreMandos &&
            !arrastrando &&
            !player.matches(':focus-within')
          ) player.dataset.controls = 'hidden';
        }, CONTROL_IDLE_MS);
      }
    };

    const pintarSonido = () => {
      const prendido = !video.muted && video.volume > 0;
      player.dataset.sonido = prendido ? 'on' : 'off';
      sonido.ariaPressed = String(prendido);
      sonido.ariaLabel = prendido ? 'Silenciar' : 'Activar sonido';
    };

    const pintarSubtitulo = () => {
      const prendido = pista?.mode === 'hidden';
      const cues = prendido ? Array.from(pista?.activeCues ?? []) : [];
      subtitulo.textContent = cues
        .map((cue) => (cue as VTTCue).text.replace(/\s+/g, ' ').trim())
        .filter(Boolean)
        .join('\n');
    };

    const pintarTexto = () => {
      if (textoQuemado) {
        player.dataset.texto = 'burned';
        texto.hidden = true;
        texto.disabled = true;
        subtitulo.textContent = '';
        return;
      }
      const prendido = Boolean(pista && pista.mode !== 'disabled');
      player.dataset.texto = prendido ? 'on' : 'off';
      texto.ariaPressed = String(prendido);
      texto.ariaLabel = prendido ? 'Ocultar subtítulos' : 'Mostrar subtítulos';
      texto.disabled = !pista;
      pintarSubtitulo();
    };

    const pintarPantalla = () => {
      const prendida = document.fullscreenElement === player || pantallaNativa;
      pantalla.ariaPressed = String(prendida);
      pantalla.ariaLabel = prendida ? 'Salir de pantalla completa' : 'Abrir pantalla completa';
      pantallaLabel.textContent = prendida ? 'salir' : 'pantalla';
    };

    const pintarCarga = () => {
      if (!video.duration || video.buffered.length === 0) {
        player.style.setProperty('--cargado', '0');
        return;
      }

      let final = 0;
      for (let i = 0; i < video.buffered.length; i += 1) {
        if (video.buffered.start(i) <= video.currentTime) final = video.buffered.end(i);
      }
      player.style.setProperty('--cargado', String(Math.min(final / video.duration, 1)));
    };

    const pintarTiempo = () => {
      const total = video.duration;
      const corre = Number.isFinite(total) && total > 0;
      const progreso = corre ? Math.min(video.currentTime / total, 1) : 0;
      const segundo = Math.floor(video.currentTime);

      player.style.setProperty('--visto', String(progreso));
      rango.value = String(Math.round(progreso * 1000));

      if (segundo !== segundoPintado) {
        const tiempoActual = formatoTiempo(video.currentTime);
        const tiempoTotal = corre ? formatoTiempo(total) : duracion.textContent || '00:00';
        actual.textContent = tiempoActual;
        if (corre) duracion.textContent = tiempoTotal;
        rango.ariaValueText = `${tiempoActual} de ${tiempoTotal}`;
        segundoPintado = segundo;
      }
    };

    const seguirTiempo = () => {
      window.cancelAnimationFrame(cuadro);
      const paso = () => {
        pintarTiempo();
        if (!video.paused && !video.ended) cuadro = window.requestAnimationFrame(paso);
      };
      cuadro = window.requestAnimationFrame(paso);
    };

    const ponerEstado = (estado: 'idle' | 'loading' | 'playing' | 'paused' | 'ended' | 'error') => {
      player.dataset.state = estado;
      player.ariaBusy = estado === 'loading' ? 'true' : 'false';

      if (estado === 'playing') {
        toggleLabel.textContent = 'pausa';
        toggle.ariaLabel = 'Pausar cinta';
        lienzo.ariaLabel = 'Pausar cinta';
        mostrarMandos(true);
        return;
      }

      mostrarMandos();

      if (estado === 'loading') {
        llamada.textContent = 'cargando cinta';
        detalle.textContent = 'espera';
        toggleLabel.textContent = 'pausa';
        toggle.ariaLabel = 'Pausar carga';
        lienzo.ariaLabel = 'Pausar carga';
      } else if (estado === 'paused') {
        llamada.textContent = 'seguir cinta';
        detalle.textContent = `${formatoTiempo(video.currentTime)} / ${duracion.textContent || '00:00'}`;
        toggleLabel.textContent = 'correr';
        toggle.ariaLabel = 'Reproducir cinta';
        lienzo.ariaLabel = 'Reproducir cinta';
      } else if (estado === 'ended') {
        llamada.textContent = 'volver a correr';
        detalle.textContent = 'fin de cinta';
        toggleLabel.textContent = 'otra vez';
        toggle.ariaLabel = 'Reproducir de nuevo';
        lienzo.ariaLabel = 'Reproducir de nuevo';
        anunciar('Fin de cinta.');
      } else if (estado === 'error') {
        llamada.textContent = 'intentar de nuevo';
        detalle.textContent = 'la cinta no cargó';
        toggleLabel.textContent = 'reintentar';
        toggle.ariaLabel = 'Intentar cargar la cinta de nuevo';
        lienzo.ariaLabel = 'Intentar cargar la cinta de nuevo';
        anunciar('La cinta no cargó. Intenta de nuevo.');
      } else {
        llamada.textContent = 'correr cinta';
        toggleLabel.textContent = 'correr';
      }
    };

    const alternar = async () => {
      if (!video.paused && !video.ended) {
        video.pause();
        return;
      }

      if (video.ended || player.dataset.state === 'error') {
        video.currentTime = 0;
        if (player.dataset.state === 'error') video.load();
      }

      ponerEstado('loading');
      try {
        await video.play();
      } catch (error) {
        if (error instanceof DOMException && error.name === 'AbortError') return;
        ponerEstado('error');
      }
    };

    const alternarSonido = () => {
      video.muted = !video.muted;
      if (!video.muted && video.volume === 0) video.volume = 1;
      pintarSonido();
      anunciar(video.muted ? 'Sonido apagado.' : 'Sonido encendido.');
      mostrarMandos(true);
    };

    const alternarTexto = () => {
      if (!pista || textoQuemado) return;
      pista.mode = pista.mode === 'disabled' ? 'hidden' : 'disabled';
      pintarTexto();
      anunciar(pista.mode === 'hidden' ? 'Subtítulos encendidos.' : 'Subtítulos apagados.');
      mostrarMandos(true);
    };

    const alternarPantalla = async () => {
      try {
        if (document.fullscreenElement) {
          await document.exitFullscreen();
        } else if (player.requestFullscreen) {
          await player.requestFullscreen();
        } else {
          video.webkitEnterFullscreen?.();
        }
      } catch {
        anunciar('No se pudo abrir pantalla completa.');
      }
      pintarPantalla();
      mostrarMandos(true);
    };

    lienzo.addEventListener('click', () => {
      const tactil = window.matchMedia('(hover: none), (pointer: coarse)').matches;
      if (tactil && player.dataset.state === 'playing' && player.dataset.controls === 'hidden') {
        mostrarMandos(true);
        return;
      }
      void alternar();
    });
    toggle.addEventListener('click', () => void alternar());
    sonido.addEventListener('click', alternarSonido);
    texto.addEventListener('click', alternarTexto);
    pantalla.addEventListener('click', () => void alternarPantalla());

    lienzo.addEventListener('keydown', (evento) => {
      const tecla = evento.key.toLowerCase();
      if (tecla === 'k') {
        evento.preventDefault();
        void alternar();
      } else if (tecla === 'm') {
        evento.preventDefault();
        alternarSonido();
      } else if (tecla === 'c') {
        evento.preventDefault();
        alternarTexto();
      } else if (tecla === 'f') {
        evento.preventDefault();
        void alternarPantalla();
      } else if ((evento.key === 'ArrowLeft' || evento.key === 'ArrowRight') && Number.isFinite(video.duration)) {
        evento.preventDefault();
        const salto = evento.key === 'ArrowLeft' ? -5 : 5;
        video.currentTime = Math.min(Math.max(video.currentTime + salto, 0), video.duration);
        pintarTiempo();
      }
    });

    rango.addEventListener('input', () => {
      if (!Number.isFinite(video.duration) || video.duration <= 0) return;
      video.currentTime = (Number(rango.value) / 1000) * video.duration;
      pintarTiempo();
      mostrarMandos(true);
    });
    rango.addEventListener('pointerdown', () => {
      arrastrando = true;
      mostrarMandos();
    });
    rango.addEventListener('pointerup', () => {
      arrastrando = false;
      mostrarMandos(true);
    });
    rango.addEventListener('pointercancel', () => {
      arrastrando = false;
      mostrarMandos(true);
    });

    video.addEventListener('loadedmetadata', () => {
      rango.disabled = false;
      duracion.textContent = formatoTiempo(video.duration);
      pista && (pista.mode = textoQuemado || player.dataset.texto === 'off' ? 'disabled' : 'hidden');
      pintarTiempo();
      pintarCarga();
      pintarTexto();
    });
    video.addEventListener('waiting', () => ponerEstado('loading'));
    video.addEventListener('playing', () => {
      ponerEstado('playing');
      seguirTiempo();
    });
    video.addEventListener('pause', () => {
      window.cancelAnimationFrame(cuadro);
      if (!video.ended && player.dataset.state !== 'error') ponerEstado('paused');
    });
    video.addEventListener('ended', () => {
      window.cancelAnimationFrame(cuadro);
      pintarTiempo();
      ponerEstado('ended');
    });
    video.addEventListener('error', () => ponerEstado('error'));
    video.addEventListener('progress', pintarCarga);
    video.addEventListener('volumechange', pintarSonido);
    video.addEventListener('seeking', pintarTiempo);
    pista?.addEventListener('cuechange', pintarSubtitulo);

    player.addEventListener('pointermove', () => mostrarMandos(true));
    mandos.addEventListener('pointerenter', () => {
      sobreMandos = true;
      mostrarMandos();
    });
    mandos.addEventListener('pointerleave', () => {
      sobreMandos = false;
      mostrarMandos(true);
    });
    player.addEventListener('focusin', () => mostrarMandos());
    player.addEventListener('focusout', (evento) => {
      if (!(evento.relatedTarget instanceof Node) || !player.contains(evento.relatedTarget)) {
        mostrarMandos(true);
      }
    });

    document.addEventListener('fullscreenchange', pintarPantalla);
    video.addEventListener('webkitbeginfullscreen', () => {
      pantallaNativa = true;
      if (pista?.mode === 'hidden') pista.mode = 'showing';
      pintarPantalla();
      pintarTexto();
    });
    video.addEventListener('webkitendfullscreen', () => {
      pantallaNativa = false;
      if (pista?.mode === 'showing') pista.mode = 'hidden';
      pintarPantalla();
      pintarTexto();
    });

    pista && (pista.mode = textoQuemado ? 'disabled' : 'hidden');
    video.controls = false;
    player.dataset.iniciado = 'true';
    player.dataset.enhanced = 'true';
    pintarSonido();
    pintarTexto();
    pintarPantalla();
  });
</script>

<style>
  /* Hallmark · component: video-player · genre: atmospheric · theme: museo
   * states: default · hover · focus · active · disabled · loading · error · success
   * contrast: pass (40–41) · mobile: pass (34, 49–57)
   */
  /* Hallmark · pre-emit critique: P5 H5 E4 S5 R5 V4 */

  .cinta-player {
    position: relative;
    isolation: isolate;
    width: var(--cinta-ancho, min(100%, calc(82svh * var(--cinta-razon))));
    aspect-ratio: var(--cinta-aspect);
    max-height: var(--cinta-alto-max, 82svh);
    margin-block-start: var(--cinta-margen-arriba, clamp(var(--space-lg), 6vh, var(--space-2xl)));
    margin-inline: auto;
    overflow: clip;
    container-type: inline-size;
    color: var(--papel);
    background: var(--color-video);
    border: var(--rule-hair) solid var(--linea);
  }

  .cinta-player__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: contain;
    background: var(--color-video);
  }

  .cinta-player__video::cue {
    color: var(--papel);
    background: color-mix(in oklab, var(--fondo) 88%, transparent);
    font-family: var(--f-voz);
  }

  .cinta-player__subtitulo {
    position: absolute;
    z-index: var(--z-raised);
    inset: auto 50% clamp(5rem, 10cqi, 7rem) auto;
    width: max-content;
    max-width: min(42ch, calc(100% - (var(--space-lg) * 2)));
    padding: var(--space-2xs) var(--space-xs);
    transform: translateX(50%);
    color: var(--papel);
    background: color-mix(in oklab, var(--fondo) 86%, transparent);
    font-family: var(--f-voz);
    font-size: clamp(0.875rem, 2.4cqi, 1.125rem);
    font-weight: 400;
    line-height: 1.34;
    text-align: center;
    text-wrap: balance;
    white-space: pre-line;
    pointer-events: none;
  }

  .cinta-player__subtitulo:empty { display: none; }

  .cinta-player__lienzo {
    position: absolute;
    z-index: var(--z-base);
    inset: 0;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center start;
