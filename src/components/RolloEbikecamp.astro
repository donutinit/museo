---
import { render, type CollectionEntry } from 'astro:content';
import { oficio } from '../lib/archivo';
import '../styles/ebikecamp.css';

/** Una lámina ya resuelta por la página: medidas, candidatos y alt incluidos. */
interface Pieza {
  nn: string;
  src: string;
  conjunto: string | undefined;
  w?: number;
  h?: number;
  alt: string;
}

interface Props {
  proyecto: CollectionEntry<'projects'>;
  piezas: Pieza[];
  /** La medida de la placa de portada; la misma que precarga la página. */
  sizesCabeza: string;
}

const { proyecto, piezas, sizesCabeza } = Astro.props;
const { data } = proyecto;
const { Content } = await render(proyecto);

// Todo el texto suelto sale del frontmatter: código, oficio, lugar, año, cuenta.
const campos = [
  ['rollo', data.photosPrefix],
  ['oficio', oficio[data.type]],
  ...(data.location ? [['lugar', data.location.toLowerCase()]] : []),
  ['año', String(data.year)],
  ['piezas', String(data.photoCount)],
];

/** El marcador sobre la línea: el tramo completo, `ebikecamp 01 — 31`. */
const tramo = `${piezas[0]?.nn ?? ''} — ${piezas.at(-1)?.nn ?? ''}`;

/* ── el reparto en filas justificadas ──────────────────────────────────
   La retícula se calcula aquí, en el build, porque las medidas nativas de
   cada pieza ya las tenemos (medidas.json). Cada fila lleva sus piezas a
   una misma altura y reparte el ancho en proporción al aspect de cada una:
   así la fila cierra exacta contra el margen, nadie se recorta y el orden
   del rollo se respeta al pie de la letra. Sin JavaScript.

   La suma de aspects de una fila decide su altura: alto = ancho / suma.
   Con 2.0 las filas cierran en dos o tres piezas y quedan altas —entre un
   medio y un tercio del ancho de la hoja—, que es donde una vertical deja
   de verse chica. Subirlo mete más piezas por fila y las achica. */
const SUMA_FILA = 2.0;

const aspect = (pieza: Pieza) => (pieza.w ?? 3) / (pieza.h ?? 2);

const filas: Pieza[][] = [];
{
  let fila: Pieza[] = [];
  let suma = 0;
  for (const pieza of piezas) {
    fila.push(pieza);
    suma += aspect(pieza);
    if (suma >= SUMA_FILA) {
      filas.push(fila);
      fila = [];
      suma = 0;
    }
  }
  if (fila.length) filas.push(fila);
}

/**
 * Lo que le toca a una pieza del ancho de su fila. La última fila se mide
 * contra `SUMA_FILA` y no contra lo suyo: si se justificara, dos piezas
 * sueltas se estirarían hasta ocupar la hoja entera.
 */
const reparto = (fila: Pieza[], pieza: Pieza, ultima: boolean) => {
  const suma = fila.reduce((n, p) => n + aspect(p), 0);
  return aspect(pieza) / (ultima ? Math.max(suma, SUMA_FILA) : suma);
};

/** El `sizes` sale de esa misma parte: la hoja ocupa ~92vw hasta su tope. */
const sizesPieza = (parte: number) =>
  `(max-width: 55.99rem) 92vw, ${Math.max(1, Math.round(parte * 92))}vw`;
---

{/* el plano del paisaje: sol fijo, detrás de todo, nunca sobre una foto */}
<div class="ebikecamp-plano" aria-hidden="true">
  <span class="ebikecamp-capa ebikecamp-capa--sol"></span>
</div>

{/* la cabecera queda arriba de la línea: sello, título y registro en banda */}
<section class="ebikecamp-cabecera-zona" aria-labelledby="ebikecamp-titulo">
  <div class="ebikecamp-cabecera">
    <p class="ebikecamp-sello ebikecamp-rotulo" data-nosnippet>rollo {data.photosPrefix}</p>

    <div class="ebikecamp-titular">
      <h1 class="ebikecamp-titulo" id="ebikecamp-titulo">{data.title}</h1>

      <dl class="registro micro ebikecamp-registro">
        {campos.map(([campo, valor]) => (
          <div data-nosnippet><dt>{campo}</dt> <dd>{valor}</dd></div>
        ))}
      </dl>
    </div>
  </div>
</section>

{/* la línea cruza la hoja de lado a lado y la galería cuelga de ella */}
<section class="ebikecamp-tramo" aria-labelledby="ebikecamp-secuencia-titulo">
  <h2 class="fuera" id="ebikecamp-secuencia-titulo">Secuencia completa</h2>

  <span class="ebikecamp-marcador ebikecamp-rotulo" data-nosnippet>
    {data.photosPrefix} {tramo}
  </span>

  <div class="ebikecamp-galeria">
    {filas.map((fila, f) => (
      <div
        class="ebikecamp-fila"
        style={`--piezas:${fila.length}`}
      >
        {fila.map((pieza) => {
          const parte = reparto(fila, pieza, f === filas.length - 1);
          const primera = pieza.nn === piezas[0].nn;
          return (
            <figure class="ebikecamp-pieza" style={`--parte:${parte.toFixed(5)}`}>
              <div class="ebikecamp-mate">
                <button
                  type="button"
                  class="ebikecamp-captura"
                  data-lupa-src={pieza.src}
                  data-lupa-alt={pieza.alt}
                  aria-label={`Abrir ${pieza.alt} a pantalla completa`}
                >
                  <img
                    src={pieza.src}
                    srcset={pieza.conjunto}
                    sizes={primera ? sizesCabeza : sizesPieza(parte)}
                    alt={pieza.alt}
                    width={pieza.w}
                    height={pieza.h}
                    loading={primera ? 'eager' : 'lazy'}
                    decoding="async"
                    fetchpriority={primera ? 'high' : undefined}
                  />
                </button>
              </div>

              <figcaption class="ebikecamp-pie ebikecamp-rotulo">
                <span class="ebikecamp-dato" data-nosnippet>{data.photosPrefix} {pieza.nn}</span>
                <span data-nosnippet>{pieza.nn}/{data.photoCount}</span>
              </figcaption>
            </figure>
          );
        })}
      </div>
    ))}

    {/* el cierre: un bloque que no es foto. Adorno y datos repetidos. */}
    <div class="ebikecamp-fin" aria-hidden="true" data-nosnippet>
      <span class="ebikecamp-fin-cuenta">{String(data.photoCount).padStart(2, '0')}</span>
      <span class="ebikecamp-rotulo">fin del rollo</span>
      <span class="ebikecamp-rotulo ebikecamp-dato">{data.photosPrefix} · {data.year}</span>
    </div>
  </div>
</section>

{/* la cuenta del rollo, después de que el terreno pasó */}
<section class="ebikecamp-ficha">
  <div class="voz"><Content /></div>
</section>
