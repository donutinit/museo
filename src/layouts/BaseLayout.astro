---
import '../styles/global.css';
import { media } from '../lib/media';
import Estructurados from '../components/Estructurados.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Medida nativa de la imagen social: decide si la tarjeta va grande o chica. */
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
  /** Imagen que manda en el primer pintado; se precarga con prioridad. */
  precargar?: string;
  /** Los mismos candidatos y medida que usa el `<img>` visible. */
  precargarSrcset?: string;
  precargarSizes?: string;
  /** Grafo JSON-LD de la página. Invisible: sólo lo leen los buscadores. */
  esquema?: object;
  /** El reel va a pantalla completa: sin rail ni colofón encima. */
  desnudo?: boolean;
}

const {
  title,
  description = 'Archivo de foto y video de Von Diego. Monterrey, MX.',
  // apaisada a propósito: la tarjeta social es 1.91:1 y una vertical se recorta
  image = '/media/video-posters/entrevista-yolanda.jpg',
  imageWidth = 1920,
  imageHeight = 1080,
  imageAlt = 'Archivo de foto y video de Von Diego',
  precargar,
  precargarSrcset,
  precargarSizes,
  esquema,
  desnudo = false,
} = Astro.props;

const fullTitle = title ? `${title} — Von Diego` : 'Von Diego — archivo';
const canonicalPath = Astro.url.pathname === '/'
  ? '/'
  : `${Astro.url.pathname.replace(/\/$/, '')}/`;
const canonical = new URL(canonicalPath, Astro.site);
const socialImage = new URL(media(image), Astro.site);

// una vertical recortada al 1.91:1 de `summary_large_image` queda decapitada;
// para esas, la tarjeta chica respeta la imagen completa
const tarjeta = imageWidth >= imageHeight ? 'summary_large_image' : 'summary';

const ruta = Astro.url.pathname.replace(/\/$/, '') || '/';
const enRuta = (base: string) => ruta === base || ruta.startsWith(`${base}/`);
const enPortada = ruta === '/';

const nav = [
  { href: '/obra/', label: 'archivo', activa: enRuta('/obra') || enRuta('/video') },
  { href: '/about/', label: 'manifiesto', activa: enRuta('/about') },
  { href: '/contact/', label: 'contacto', activa: enRuta('/contact') },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0d0c0f" />

    {/* sin `crossorigin`: img y video van en modo no-CORS y ese es el pool que
        hay que calentar. Con el atributo se precalienta el pool equivocado. */}
    <link rel="preconnect" href="https://media.vondiego.com" />

    {precargar && (
      <link
        rel="preload"
        as="image"
        href={media(precargar)}
        imagesrcset={precargarSrcset}
        imagesizes={precargarSizes}
        fetchpriority="high"
      />
    )}

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Von Diego" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="es_MX" />
    <meta name="twitter:card" content={tarjeta} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {esquema && <Estructurados datos={esquema} />}
  </head>

  <body>
    {!desnudo && <a class="saltar edge" href="#hoja">Saltar a la hoja</a>}

    {!desnudo && (
    <header class="rail">
      <div class="contenedor rail-in">
        {!enPortada && <a class="rail-marca" href="/">von diego</a>}
        <nav class="rail-nav" aria-label="Secciones">
          {nav.map((i) => (
            <a href={i.href} aria-current={i.activa ? 'page' : undefined}>{i.label}</a>
          ))}
        </nav>
      </div>
    </header>
    )}

    <slot />

    {!desnudo && (
    <footer class="colofon">
      <div class="contenedor colofon-in">
        <p class="edge">von diego — archivo de foto y video</p>
        <p class="edge">monterrey, mx</p>
        <a class="edge" href="mailto:contacto@vondiego.com">contacto@vondiego.com</a>

        <nav class="colofon-redes" aria-label="Perfiles">
          <a class="edge" rel="me noopener" href="https://www.youtube.com/@vondiegoa">youtube</a>
          <a class="edge" rel="me noopener" href="https://www.instagram.com/fotos.von.diego">instagram</a>
          <a class="edge" rel="me noopener" href="https://github.com/donutinit">github</a>
          <a class="colofon-codigo edge" rel="noopener" href="https://github.com/donutinit/museo">
            <svg class="marca-gh" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
            </svg>
            <span>el código de este sitio</span>
          </a>
        </nav>
      </div>
    </footer>
    )}

    <script>
      // Las cintas de la hoja corren sólo cuando alguien las señala, y no se
      // descargan hasta entonces. En táctil y con movimiento reducido, quietas.
      const fino = window.matchMedia('(hover: hover) and (pointer: fine)');
      const quieto = window.matchMedia('(prefers-reduced-motion: reduce)');

      if (fino.matches && !quieto.matches) {
        document.querySelectorAll<HTMLAnchorElement>('.cuadro[data-cinta]').forEach((cuadro) => {
          const video = cuadro.querySelector('video');
          const fuente = cuadro.dataset.cinta;
          if (!video || !fuente) return;

          let espera = 0;

          cuadro.addEventListener('pointerenter', () => {
            window.clearTimeout(espera);
            // un respiro, para no bajar video al pasar el ratón de largo
            espera = window.setTimeout(() => {
              if (!video.src) video.src = fuente;
              video.play().then(
                () => { cuadro.dataset.corriendo = 'true'; },
                () => {}
              );
            }, 120);
          });

          cuadro.addEventListener('pointerleave', () => {
            window.clearTimeout(espera);
            delete cuadro.dataset.corriendo;
            video.pause();
          });
        });
      }
    </script>
  </body>
</html>
