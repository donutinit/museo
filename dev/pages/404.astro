---
import Producto from '../layouts/Producto.astro';
---

<Producto titulo="404" descripcion="Esta ruta no tiene registro." noindex>
  <div class="ancho pagina-cab vacio">
    <p class="vacio-num">404</p>
    <h1>este cuadro salió velado</h1>
    <p>La ruta existe, el registro no. Pasa: se vela un cuadro y se sigue con el rollo.</p>
    <div class="hero-acciones">
      <a class="boton boton-tinta" href="/">Ir al inicio</a>
      <a class="boton boton-linea" href="/changelog/">Ver el changelog</a>
    </div>
  </div>
</Producto>
