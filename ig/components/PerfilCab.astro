---
/**
 * La cabecera del perfil: avatar, usuario, cuentas, biografía, destacadas y
 * pestañas. Las cuentas salen del archivo; seguidores no hay porque aquí no
 * existen. "Seguir" lleva al perfil de verdad.
 */
import Avatar from './Avatar.astro';
import Icono from './Icono.astro';
import Historias from './Historias.astro';
import { persona } from '../../src/lib/seo';
// el manifiesto vive una sola vez fuera del sitio principal, en von/textos
import { Content as Leeme } from '../../von/textos/README.md';
import { publicaciones, cuentas, USUARIO, NOMBRE, INSTAGRAM, SITIO_PRINCIPAL } from '../lib/perfil';

interface Props {
  pestana: 'publicaciones' | 'reels';
}

const { pestana } = Astro.props;
const todo = await publicaciones();
const c = cuentas(todo);
const sitio = new URL(SITIO_PRINCIPAL).hostname;
---

<header class="perfil-cab">
  <div class="perfil-avatar"><Avatar lado={150} /></div>

  <div class="perfil-fila">
    <h1>{USUARIO}</h1>
    <a class="boton boton-azul" href={INSTAGRAM} rel="me">Seguir</a>
    <a class="boton" href="/contact/">Enviar mensaje</a>
  </div>

  <ul class="perfil-cuentas">
    <li><strong>{c.publicaciones}</strong> publicaciones</li>
    <li><strong>{c.fotos}</strong> fotos</li>
    <li><strong>{c.reels}</strong> reels</li>
  </ul>

  <div class="perfil-bio" data-bio>
    <p class="perfil-nombre">{NOMBRE}</p>
    <p class="tenue">{persona().jobTitle}</p>
    <div class="perfil-prosa"><Leeme /></div>
    <button class="perfil-mas" type="button" data-bio-mas hidden>más</button>
    <a class="perfil-sitio" href={SITIO_PRINCIPAL}>{sitio}</a>
  </div>
</header>

<Historias todo={todo} nombre="Historias destacadas" />

<nav class="perfil-pestanas" aria-label="Perfil">
  <a href="/about/" aria-current={pestana === 'publicaciones' ? 'page' : undefined}>
    <Icono nombre="cuadricula" lado={12} /><span>Publicaciones</span>
  </a>
  <a href="/reels/" aria-current={pestana === 'reels' ? 'page' : undefined}>
    <Icono nombre="reels" lado={12} /><span>Reels</span>
  </a>
</nav>

<script>
  // la biografía llega entera; con script se guarda tras un "más", como en la red
  const bio = document.querySelector<HTMLElement>('[data-bio]');
  const mas = document.querySelector<HTMLButtonElement>('[data-bio-mas]');
  if (bio && mas) {
    mas.hidden = false;
    mas.addEventListener('click', () => {
      bio.classList.add('perfil-bio-abierta');
      mas.hidden = true;
    });
  }
</script>
