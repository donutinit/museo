  derecha: 'M9.5 6l6 6-6 6',
  fuera: 'M14 5h5v5M19 5l-8 8M11 6H6v12h12v-5',
} as const;

// Los que van rellenos: se ven sobre una foto y un trazo solo se perdería.
const LLENOS = {
  carrusel: 'M8 3h10a3 3 0 0 1 3 3v10h-2V6a1 1 0 0 0-1-1H8zM3 9a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z',
  reel: 'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4zm3 6.2v5.6a.6.6 0 0 0 .9.5l4.7-2.8a.6.6 0 0 0 0-1l-4.7-2.8a.6.6 0 0 0-.9.5z',
  correr: 'M8 5v14l11-7z',
  pausa: 'M7 5h4v14H7zM13 5h4v14h-4z',
  sonido: 'M4 9.5v5h3.5L12 19V5L7.5 9.5zM15 8.5a5 5 0 0 1 0 7l-1.2-1.2a3.3 3.3 0 0 0 0-4.6z',
  mudo: 'M4 9.5v5h3.5L12 19V5L7.5 9.5zM15.3 9.3l1.9 1.9 1.9-1.9 1.2 1.2-1.9 1.9 1.9 1.9-1.2 1.2-1.9-1.9-1.9 1.9-1.2-1.2 1.9-1.9-1.9-1.9z',
} as const;

interface Props {
  nombre: keyof typeof TRAZOS | keyof typeof LLENOS;
  lado?: number;
  class?: string;
}

const { nombre, lado = 24, class: clase } = Astro.props;
const lleno = nombre in LLENOS;
const d = lleno ? LLENOS[nombre as keyof typeof LLENOS] : TRAZOS[nombre as keyof typeof TRAZOS];
---

<svg
  class:list={['icono', clase]}
  viewBox="0 0 24 24"
  width={lado}
  height={lado}
  fill={lleno ? 'currentColor' : 'none'}
  stroke={lleno ? 'none' : 'currentColor'}
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
><path d={d} /></svg>
