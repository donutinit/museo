const TRAZOS = {
  inicio: 'M3 11.5 12 3.5l9 8V21h-6v-6.5H9V21H3z',
  buscar: 'M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM16.5 16.5 21 21',
  reels: 'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4zM3 8.5h18M8.5 3l3 5.5M14 3l3 5.5M10 12v5.5l5-2.75z',
  mensajes: 'M21 3 3 10.5l7 2.5 2.5 7zM10 13 21 3',
  corazon: 'M12 20.5s-8-4.9-8-10.6A4.4 4.4 0 0 1 12 7.4a4.4 4.4 0 0 1 8 2.5c0 5.7-8 10.6-8 10.6z',
  comentario: 'M20.5 12a8.5 8.5 0 1 0-3.7 7l3.7 1-1.1-3.5a8.4 8.4 0 0 0 1.1-4.5z',
  cuadricula: 'M3 3h18v18H3zM9 3v18M15 3v18M3 9h18M3 15h18',
  cerrar: 'M5 5l14 14M19 5 5 19',
