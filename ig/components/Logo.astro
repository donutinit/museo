---
// La marca: la cámara de esquinas redondas y el nombre en cursiva.
// En la barra angosta queda sólo la cámara; en la ancha, sólo el nombre.
import { SITIO } from '../lib/perfil';
---

<a class="logo" href="/" aria-label={`${SITIO}, inicio`}>
  <svg class="logo-camara" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <rect x="3" y="3" width="18" height="18" rx="5.5" />
    <circle cx="12" cy="12" r="4.2" />
    <circle cx="17.3" cy="6.7" r="0.6" fill="currentColor" />
  </svg>
  <span class="logo-texto">{SITIO}</span>
</a>
