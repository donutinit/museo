{
  // ig.vondiego.com: el mismo archivo con piel de red social de fotos.
  // Igual que `museo`: `assets` sin `main` = solo archivos.
  // El dominio se agrega una sola vez (ver docs/03).
  "name": "museo-ig",
  "compatibility_date": "2026-09-06",
  "assets": {
    "directory": "./dist-ig",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
