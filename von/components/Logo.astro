---
// La marca en el lugar donde gitweb pone la suya: 72 × 27, a la derecha.
// Letras de bloque y los dos signos de un diff, quitar y poner.
const U = 3;
const GLIFOS = [
  ['X...X', 'X...X', 'X...X', '.X.X.', '..X..'],
  ['.XXX.', 'X...X', 'X...X', 'X...X', '.XXX.'],
  ['XXXX.', 'X...X', 'X...X', 'X...X', 'X...X'],
];

const bloques = GLIFOS.flatMap((glifo, g) =>
  glifo.flatMap((fila, y) =>
    [...fila].flatMap((c, x) => (c === 'X' ? [{ x: (g * 7 + x) * U, y: 6 + y * U }] : []))
  )
);
---

<svg width="72" height="27" viewBox="0 0 72 27" role="img" aria-label="von">
  {bloques.map((b) => <rect x={b.x} y={b.y} width={U} height={U} fill="#000000" />)}
  <rect x="60" y="6" width="9" height="3" fill="#cc0000" />
  <rect x="60" y="15" width="9" height="3" fill="#008800" />
  <rect x="63" y="12" width="3" height="9" fill="#008800" />
</svg>
