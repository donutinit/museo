---
import Gitweb from '../../layouts/Gitweb.astro';
import Cinta from '../../components/Cinta.astro';
import { cintasPorFecha, kindLabel, subtitulosDe } from '../../../src/data/videos';
import { media, medidaDe } from '../../../src/lib/media';
import { medidaCinta } from '../../../src/lib/archivo';
import { descripcionCinta } from '../../../src/lib/seo';
import { tieneSubtitulos } from '../../lib/subtitulos';
import { REPO } from '../../lib/git';

export function getStaticPaths() {
  return cintasPorFecha.map((cinta, i) => ({
    params: { slug: cinta.slug },
    props: {
      cinta,
      anterior: cintasPorFecha[i - 1] ?? null,
      siguiente: cintasPorFecha[i + 1] ?? null,
    },
  }));
}

const { cinta, anterior, siguiente } = Astro.props;
const [pw, ph] = medidaDe(cinta.poster) ?? medidaCinta(cinta.aspect);
const subtitulos = tieneSubtitulos(cinta.slug);
/** `00:53` → `0:53`, como lo pinta el player una vez que carga. */
const corre = cinta.durationLabel.replace(/^0(?=\d:)/, '');
---

<Gitweb
  vista="blob"
  objeto={`${cinta.slug}.mp4`}
  titulo={`${cinta.title} | Von Diego`}
  descripcion={descripcionCinta(cinta)}
  canonica={`/video/${cinta.slug}/`}
  imagen={cinta.poster}
>
  <Fragment slot="sub">
    <a href={media(cinta.src)}>raw</a>
    <span>&nbsp;|&nbsp;</span>
    {anterior ? <a href={`/video/${anterior.slug}/`} title={anterior.title}>prev</a> : <span>prev</span>}
    <span>&nbsp;&sdot;&nbsp;</span>
    {siguiente ? <a href={`/video/${siguiente.slug}/`} title={siguiente.title}>next</a> : <span>next</span>}
  </Fragment>

  <div class="ruta"><a href="/tree/">[{REPO}]</a> / {cinta.slug}.mp4</div>

  <div class="titulo">{cinta.title}</div>
  <Cinta
    src={media(cinta.src)}
    poster={media(cinta.poster)}
    subtitulos={subtitulos ? subtitulosDe(cinta.slug) : undefined}
    quemados={cinta.captionsBurned}
    corre={corre}
    ancho={pw}
    alto={ph}
  />

  <div class="ficha-cab">
    <table>
      <tr><td>cinta</td><td class="sha">{cinta.slug}</td></tr>
      <tr><td>oficio</td><td>{kindLabel[cinta.kind].toLowerCase()}</td></tr>
      <tr><td>año</td><td>{cinta.year}</td></tr>
      <tr><td>corre</td><td>{cinta.durationLabel}</td></tr>
      <tr><td>cuadro</td><td>{cinta.aspect}</td></tr>
      <tr><td>formato</td><td>h.264 aac</td></tr>
    </table>
  </div>

  {cinta.caption && <div class="cuerpo">{cinta.caption}</div>}
</Gitweb>
